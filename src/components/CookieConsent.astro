---
// Cookie Consent — vanilla-cookieconsent v3 | English · professional
---

<script>
import * as ccModule from 'vanilla-cookieconsent';
import 'vanilla-cookieconsent/dist/cookieconsent.css';

const api = ccModule.run({
  cookie: {
    name: 'cc-consent',
    domain: window.location.hostname,
    path: '/',
    sameSite: 'Lax',
    useLocalStorage: true,
    // Cookie expiry: 365 days
    expiryInDays: 365,
  },
  guiOptions: {
    consentModal: {
      layout: 'cloud',
      position: 'bottom center',
      equalWeightButtons: true,
      flipButtons: false,
    },
    preferencesModal: {
      layout: 'box',
      position: 'right',
      equalWeightButtons: true,
      flipButtons: false,
    },
  },
  categories: {
    necessary: {
      enabled: true,
      readOnly: true,
      services: {
        cookieConsent: { label: 'Consent preferences' },
        themePrefs: { label: 'Theme preference (light/dark)' },
      },
    },
  },
  language: {
    default: 'en',
    translations: {
      en: {
        consentModal: {
          title: 'This site uses essential cookies only',
          description:
            'We only use technical cookies that are strictly necessary for the site to function and to remember your preferences (theme and consent choice). We also use <strong>Plausible Analytics</strong> self-hosted — no cookies, no profiling, aggregated only. <a href="/privacy/" class="cc-link">Full disclosure</a>.',
          acceptAllBtn: 'Accept',
          acceptNecessaryBtn: 'Accept necessary only',
          showPreferencesBtn: 'Cookie preferences',
          footer:
            '<a href="/privacy/">Privacy Policy</a> · <a href="/cookies/">Cookie Policy</a> · <a href="/terms/">Terms of Service</a>',
        },
        preferencesModal: {
          title: 'Cookie Preferences',
          acceptAllBtn: 'Accept all',
          acceptNecessaryBtn: 'Accept necessary only',
          savePreferencesBtn: 'Save preferences',
          closeIconLabel: 'Close',
          sections: [
            {
              title: 'Necessary Cookies',
              description:
                'These cookies are essential for the website to function properly. They enable core functionality such as theme persistence (dark/light mode) and consent state storage. No personally identifiable information is collected.',
              linkedCategory: 'necessary',
            },
            {
              title: 'Analytics',
              description:
                'This site uses <strong>Plausible Analytics</strong> self-hosted on <code>plausible.pyragogy.org</code> to measure page views and referrers. Plausible does not use cookies, does not profile users, and does not collect personal data. IP addresses are anonymized at the server level. The data is used solely to understand which patterns are read most — no advertising, no data selling, no third-party sharing. <a href="https://plausible.io/data-policy" target="_blank" rel="noopener noreferrer">Plausible Data Policy</a>.',
            },
            {
              title: 'Third-Party Services',
              description:
                'This site uses <strong>Giscus</strong> for comments (powered by GitHub Discussions) and is hosted via <strong>GitHub Pages</strong>. These services may set their own cookies for authentication and security. Please refer to the <a href="https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement" target="_blank" rel="noopener noreferrer">GitHub Privacy Statement</a> for details.',
            },
            {
              title: 'Your Rights',
              description:
                'Under the GDPR (if you are in the EU/EEA/UK) and similar privacy frameworks, you have the right to access, rectify, or erase your data, and to lodge a complaint with your local data protection authority. For inquiries: <a href="mailto:info@pyragogy.org">info@pyragogy.org</a>.',
            },
            {
              title: 'More Information',
              description:
                'Read our full <a href="/privacy/">Privacy Policy</a>, <a href="/cookies/">Cookie Policy</a>, and <a href="/terms/">Terms of Service</a>, or contact us at <a href="mailto:info@pyragogy.org">info@pyragogy.org</a>.',
            },
          ],
        },
      },
    },
  },
});

// Expose for footer "Manage Cookies" button
// ccModule is the library; api is the running instance with showPreferences
window.__cc = api;
</script>

<style>
  /* Mobile: full-width consent modal */
  @media (max-width: 640px) {
    #cc-main .cm__body {
      flex-direction: column !important;
    }
    #cc-main .cm__btns {
      flex-direction: column !important;
      gap: 0.5rem !important;
    }
    #cc-main .cm__btn {
      min-width: 100% !important;
      margin: 0 !important;
    }
    #cc-main .pm__body {
      padding: 1rem !important;
    }
  }
</style>