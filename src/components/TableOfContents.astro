---
import { getCollection } from "astro:content";

export interface Props {
  slug: string;
  section?: string;
}

const { section } = Astro.props;
const allEntries = await getCollection("peeragogy");

// Section order from the original ToC — this controls sidebar ordering
const SECTION_ORDER = [
  "Introduction",
  "Motivation",
  "Peeragogy in Practice",
  "Convening a Group",
  "Organizing a Learning Context",
  "Cooperation",
  "Assessment",
  "Technologies, Services, and Platforms",
  "Resources",
];

// Collect sections preserving ToC order
const sectionSet = new Set(allEntries.map((e) => e.data.section).filter(Boolean));
const sections = SECTION_ORDER.filter((s) => sectionSet.has(s));
// Add any extra sections not in order at the end
sectionSet.forEach((s) => { if (!SECTION_ORDER.includes(s)) sections.push(s); });
---

<nav class="space-y-6">
  <div class="mb-4">
    <h3 class="text-xs font-semibold uppercase tracking-wider d-text-dim">Sections</h3>
  </div>

  <ul class="space-y-1">
    {sections.map((s) => {
      const entries = allEntries.filter((e) => e.data.section === s).sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
      const isActive = s === section;
      return (
        <li>
          <details open={isActive}>
            <summary class="cursor-pointer rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-stone-100 d-hover">
              {s}
            </summary>
            <ul class="ml-3 mt-1 space-y-0.5 border-l border-stone-200 d-border pl-3">
              {entries.map((e) => (
                <li>
                  <a
                    href={`/${e.slug}/`}
                    class={`block rounded-md px-3 py-1.5 text-sm transition-colors ${
                      e.slug === Astro.props.slug
                        ? "toc-link-active border-l-2 border-(--color-accent) -ml-[14px] pl-[10px]"
                        : "d-text-sec hover:text-(--color-text) hover:bg-stone-100 d-hover"
                    }`}
                  >
                    {e.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      );
    })}
  </ul>
</nav>