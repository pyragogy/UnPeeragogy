---
export interface Props {
  slug: string;
  title: string;
}

const { slug, title } = Astro.props;
---

<section class="mt-12 border-t border-red-200 d-red-bdr pt-8">
  <h2 class="text-lg font-bold mb-4 flex items-center gap-2">
    <span>💬</span> Discussione: {title}
  </h2>
  <p class="text-sm d-text-dim mb-4">Questa discussione è ancorata al piano della realtà operativa. Niente teoria — solo esperienze, fallimenti, e verità scomode.</p>

  <div id="giscus-container" class="min-h-[200px] flex items-center justify-center">
    <div class="text-center d-text-dim text-sm">
      <p class="mb-2">💬 Le discussioni sono attive su GitHub Discussions.</p>
      <p class="text-xs">Disponibile quando deployato su un dominio pubblico con Giscus configurato.</p>
    </div>
  </div>

  <script>
    if (window.location.hostname !== "localhost" && window.location.hostname !== "127.0.0.1") {
      const script = document.createElement("script");
      script.src = "https://giscus.app/client.js";
      script.setAttribute("data-repo", "pyragogy/unpeeragogy");
      script.setAttribute("data-repo-id", "");
      script.setAttribute("data-category", "Announcements");
      script.setAttribute("data-category-id", "");
      script.setAttribute("data-mapping", "specific");
      script.setAttribute("data-term", `section: ${slug}`);
      script.setAttribute("data-strict", "0");
      script.setAttribute("data-reactions-enabled", "1");
      script.setAttribute("data-emit-metadata", "0");
      script.setAttribute("data-input-position", "top");
      script.setAttribute("data-theme", "preferred_color_scheme");
      script.setAttribute("data-lang", "en");
      script.setAttribute("crossorigin", "anonymous");
      script.setAttribute("async", "");
      document.getElementById("giscus-container")?.appendChild(script);
    }
  </script>
</section>

<style>
  section {
    scroll-margin-top: 5rem;
  }
</style>