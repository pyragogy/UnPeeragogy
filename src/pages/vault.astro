---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  return [{ params: {}, props: {} }];
}

const peeragogyEntries = await getCollection("peeragogy");
const unpeeragogyEntries = await getCollection("unpeeragogy");

// Sections
const sections = new Map();
for (const entry of peeragogyEntries) {
  const section = entry.data.section || "Altri";
  if (!sections.has(section)) sections.set(section, []);
  sections.get(section).push(entry);
}
for (const [, entries] of sections) {
  entries.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
}

// Tag index
const allTags = new Set();
for (const entry of [...peeragogyEntries, ...unpeeragogyEntries]) {
  if (entry.data.tags) entry.data.tags.forEach(t => allTags.add(t));
}

// Section order
const sectionOrder = Array.from(sections.keys()).sort((a, b) => {
  const aMin = Math.min(...sections.get(a).map(e => e.data.order || 99));
  const bMin = Math.min(...sections.get(b).map(e => e.data.order || 99));
  return aMin - bMin;
});

// Section palette (9 sezioni del handbook + fallback)
const sectionColors = {
  "Peeragogy in Practice":                  "#6366f1",
  "Resources":                              "#8b5cf6",
  "Cooperation":                            "#06b6d4",
  "Convening a Group":                      "#d946ef",
  "Introduction":                           "#10b981",
  "Organizing a Learning Context":          "#f59e0b",
  "Technologies, Services, and Platforms":  "#f97316",
  "Motivation":                             "#ec4899",
  "Assessment":                             "#84cc16",
  "Altri":                                  "#a1a1aa",
};
const sectionMap = Object.fromEntries(
  sectionOrder.map(s => [s, { color: sectionColors[s] || "#a1a1aa", order: sectionOrder.indexOf(s) }])
);

// Build 3D graph data — topology: within-section + paired cross-links
const graphNodes = [];
const graphLinks = [];
const nodeMap = new Map();

for (const pe of peeragogyEntries) {
  const ue = unpeeragogyEntries.find(e => e.slug === pe.slug);
  const sec = pe.data.section || "Altri";
  const node = {
    id: pe.slug,
    name: pe.data.title || pe.slug,
    group: ue ? "unpeeragogy" : "peeragogy",
    val: ue ? 2 : 1,
    tension: ue?.data?.tension_index ?? null,
    section: sec,
    sectionColor: sectionColors[sec] || "#a1a1aa",
    readingTime: pe.data.readingTime ?? 0,
  };
  nodeMap.set(pe.slug, node);
  graphNodes.push(node);
}

// Add unpeeragogy-only entries
for (const ue of unpeeragogyEntries) {
  if (!peeragogyEntries.find(e => e.slug === ue.slug)) {
    const sec = ue.data.section || "Altri";
    const node = {
      id: ue.slug,
      name: ue.data.title || ue.slug,
      group: "unpeeragogy-only",
      val: 2,
      tension: ue.data.tension_index ?? null,
      section: sec,
      sectionColor: sectionColors[sec] || "#a1a1aa",
      readingTime: ue.data.readingTime ?? 0,
    };
    nodeMap.set(ue.slug, node);
    graphNodes.push(node);
  }
}

// Edges: within-section ordering (chain each section)
for (const [, entries] of sections) {
  for (let i = 0; i < entries.length - 1; i++) {
    graphLinks.push({ source: entries[i].slug, target: entries[i + 1].slug, type: "chain" });
  }
}

// Bridge edges: last node of section N → first node of section N+1
for (let i = 0; i < sectionOrder.length - 1; i++) {
  const cur = sections.get(sectionOrder[i]);
  const next = sections.get(sectionOrder[i + 1]);
  if (cur && cur.length > 0 && next && next.length > 0) {
    graphLinks.push({ source: cur[cur.length - 1].slug, target: next[0].slug, type: "bridge" });
  }
}

// Tag-based chain edges (structural tags with 3-15 nodes, avoids hairball)
const tagGroups = new Map();
for (const pe of peeragogyEntries) {
  if (pe.data.tags) {
    for (const tag of pe.data.tags) {
      if (!tagGroups.has(tag)) tagGroups.set(tag, []);
      tagGroups.get(tag).push(pe.slug);
    }
  }
}
for (const [tag, slugs] of tagGroups) {
  if (slugs.length >= 3 && slugs.length <= 15) {
    for (let i = 0; i < slugs.length - 1; i++) {
      graphLinks.push({ source: slugs[i], target: slugs[i + 1], type: "tag-" + tag });
    }
  }
}

// Map tags per slug (combining peer + unpeer for cross-section tag matching)
const nodeTags = {};
for (const pe of peeragogyEntries) {
  const tags = new Set();
  if (pe.data.tags) pe.data.tags.forEach(t => tags.add(t));
  const ue = unpeeragogyEntries.find(e => e.slug === pe.slug);
  if (ue && ue.data.tags) ue.data.tags.forEach(t => tags.add(t));
  if (tags.size > 0) nodeTags[pe.slug] = Array.from(tags);
}
for (const ue of unpeeragogyEntries) {
  if (!peeragogyEntries.find(e => e.slug === ue.slug) && ue.data.tags) {
    nodeTags[ue.slug] = ue.data.tags;
  }
}

// Tension-proximity edges: cross-section nodes with similar tension AND shared tags
const tensionNodes = graphNodes
  .filter(n => n.tension !== null && n.tension > 0)
  .sort((a, b) => a.tension - b.tension);
for (let i = 0; i < tensionNodes.length; i++) {
  for (let j = i + 1; j < tensionNodes.length; j++) {
    const a = tensionNodes[i];
    const b = tensionNodes[j];
    if (b.tension - a.tension > 0.3) break; // sorted, so stop early
    if (a.section !== b.section) {
      // Only connect if nodes share at least one semantic tag (not base)
      const aTags = nodeTags[a.id] || [];
      const bTags = nodeTags[b.id] || [];
      const baseTags = new Set(["unpeeragogy", "decostruzione", "anti-pattern"]);
      const shared = aTags.filter(t => bTags.includes(t) && !baseTags.has(t));
      if (shared.length > 0) {
        graphLinks.push({ source: a.id, target: b.id, type: "tension", weight: shared.length, sharedTags: shared });
        break; // at most one tension link per node
      }
    }
  }
}

// Tree data
const allTagsSorted = Array.from(allTags).sort();
const entriesBySection = {};
const peerCountBySection = {};
const unpeerCountBySection = {};

for (const s of sectionOrder) {
  entriesBySection[s] = sections.get(s).map(pe => {
    const ue = unpeeragogyEntries.find(e => e.slug === pe.slug);
    return {
      slug: pe.slug,
      title: pe.data.title || pe.slug,
      tension: ue?.data?.tension_index ?? null,
      readingTime: pe.data.readingTime ?? 0,
      tags: pe.data.tags || [],
      hasUnpeeragogy: !!ue,
    };
  });
  peerCountBySection[s] = sections.get(s).length;
  unpeerCountBySection[s] = unpeeragogyEntries.filter(e =>
    sections.get(s).some(pe => pe.slug === e.slug)
  ).length;
}
---

<BaseLayout title="Vault — Unpeeragogy Knowledge Base" description="Grafo 3D interattivo + navigazione ad albero della Knowledge Base Unpeeragogy.">
  <script set:html={JSON.stringify({ nodes: graphNodes, links: graphLinks, sections: sectionMap })} id="vault-data" type="application/json"></script>
  <section class="py-8">
    <div class="flex items-center gap-4 mb-6">
      <h1 class="text-3xl font-extrabold tracking-tight">🗂️ Knowledge Base</h1>
      <span class="rounded-full bg-stone-100 dark:d-surface px-3 py-1 text-sm">{graphNodes.length} nodi · {graphLinks.length} connessioni</span>
    </div>

    <div class="flex items-center gap-2 mb-6 p-2 bg-stone-100 dark:d-surface rounded-lg w-fit">
      <button id="view-graph-btn" class="rounded-md px-4 py-2 text-sm transition-all bg-white dark:d-raised shadow-sm font-semibold text-(--color-accent)">🕸️ Grafo 3D</button>
      <button id="view-tree-btn" class="rounded-md px-4 py-2 text-sm transition-all text-stone-600 dark:d-text-sec hover:text-(--color-text)">🌲 Albero</button>
    </div>

    <!-- Section filters (graph only) -->
    <div id="graph-filters" class="flex flex-wrap gap-2 mb-4">
      <div class="flex gap-1 mr-2 pr-2 border-r border-stone-200 dark:d-border">
        <button class="group-filter active rounded-md px-3 py-1 text-xs font-medium bg-(--color-accent) text-white" data-group="all">Tutti</button>
        <button class="group-filter rounded-md px-3 py-1 text-xs font-medium bg-stone-100 dark:d-surface text-stone-600 dark:d-text-sec hover:bg-stone-200 dark:d-hover transition-colors" data-group="unpeeragogy">⚡ Realtà</button>
        <button class="group-filter rounded-md px-3 py-1 text-xs font-medium bg-stone-100 dark:d-surface text-stone-600 dark:d-text-sec hover:bg-stone-200 dark:d-hover transition-colors" data-group="peeragogy">📖 Teoria</button>
      </div>
      {sectionOrder.map(s => (
        <button class="section-filter active rounded-full px-2.5 py-1 text-xs font-medium flex items-center gap-1.5 bg-stone-100 dark:d-surface text-stone-600 dark:d-text-sec hover:bg-stone-200 dark:d-hover transition-colors border border-transparent" data-section={s} style={`border-color:${sectionColors[s] || "#a1a1aa"}`}>
          <span class="w-2.5 h-2.5 rounded-full" style={`background:${sectionColors[s] || "#a1a1aa"}`}></span>
          {s.replace(/^(Technologies,|Organizing a|Convening a) /, "").replace(/ Services, and Platforms$/, "")}
        </button>
      ))}
    </div>

    <!-- 3D GRAPH -->
    <div id="vault-graph" class="w-full rounded-lg border border-stone-200 dark:d-border overflow-hidden" style="height:620px;position:relative;">
      <div id="force-graph" style="width:100%;height:100%;"></div>
      <div id="graph-legend" class="absolute bottom-4 left-4 flex flex-wrap gap-2 text-xs bg-white/90 dark:bg-[var(--surface-bg)]/90 px-3 py-2 rounded-lg shadow-sm dark:d-border backdrop-blur-sm max-w-[60%]">
        {sectionOrder.map(s => (
          <span class="flex items-center gap-1 whitespace-nowrap" title={s}><span class="w-3 h-3 rounded-full inline-block" style={`background:${sectionColors[s] || "#a1a1aa"}`}></span> {s.replace(/^(Technologies,|Organizing a|Convening a) /, "").replace(/ Services, and Platforms$/, "")}</span>
        ))}
        <span class="flex items-center gap-1 ml-1 pl-2 border-l border-stone-300 dark:d-border"><span class="w-2 h-2 rounded-full inline-block ring-1 ring-white dark:ring-black" style="background:#ffffff;border:2px solid currentColor;color:var(--color-text)"></span> Unpeer</span>
      </div>
      <div id="graph-controls" class="absolute bottom-4 right-4 flex flex-col gap-1.5">
        <button id="ctrl-zoom-in" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white/95 dark:bg-[var(--surface-bg)]/95 shadow-md dark:shadow-sm dark:d-border backdrop-blur-sm text-lg font-bold hover:bg-stone-100 dark:d-hover transition-all cursor-pointer select-none border border-stone-200 dark:border-0" title="Zoom + (scroll wheel)">＋</button>
        <button id="ctrl-zoom-out" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white/95 dark:bg-[var(--surface-bg)]/95 shadow-md dark:shadow-sm dark:d-border backdrop-blur-sm text-lg font-bold hover:bg-stone-100 dark:d-hover transition-all cursor-pointer select-none border border-stone-200 dark:border-0" title="Zoom - (scroll wheel)">−</button>
        <button id="ctrl-reset" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white/95 dark:bg-[var(--surface-bg)]/95 shadow-md dark:shadow-sm dark:d-border backdrop-blur-sm text-sm hover:bg-stone-100 dark:d-hover transition-all cursor-pointer select-none border border-stone-200 dark:border-0" title="Reset zoom (adatta tutto allo schermo)">⟲</button>
        <button id="ctrl-labels" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white/95 dark:bg-[var(--surface-bg)]/95 shadow-md dark:shadow-sm dark:d-border backdrop-blur-sm text-xs hover:bg-stone-100 dark:d-hover transition-all cursor-pointer select-none border border-stone-200 dark:border-0" title="Mostra/nascondi label">Aa</button>
      </div>
    </div>

    <!-- TREE -->
    <div id="vault-tree" class="hidden">
      <div class="mb-6 flex flex-wrap gap-3 items-center">
        <input id="vault-search" type="text" placeholder="Cerca capitolo..." class="rounded-lg border border-stone-200 dark:d-border bg-white dark:[background:var(--surface-bg)] px-4 py-2.5 text-sm flex-1 max-w-sm" />
        <div class="flex flex-wrap gap-2" id="tag-filters">
          <button class="tag-filter active rounded-full px-3 py-1 text-xs font-medium bg-(--color-accent) text-white" data-tag="all">Tutti</button>
          {allTagsSorted.slice(0, 20).map(tag => <button class="tag-filter rounded-full px-3 py-1 text-xs font-medium bg-stone-100 dark:d-surface text-stone-600 dark:d-text-sec hover:bg-stone-200 dark:d-hover transition-colors" data-tag={tag}>#{tag}</button>)}
        </div>
      </div>

      <div class="space-y-4" id="vault-tree-sections">
        {sectionOrder.map(s => (
          <div class="vault-section border border-stone-200 dark:d-border rounded-xl overflow-hidden" data-section={s}>
            <button class="vault-section-header w-full flex items-center justify-between px-5 py-4 bg-stone-50 dark:d-surface hover:bg-stone-100 dark:d-hover transition-colors text-left text-base font-semibold">
              <span class="flex items-center gap-3">
                <span>{s}</span>
                <span class="inline-flex items-center gap-1.5 text-xs font-normal">
                  <span class="rounded-full bg-[#4a8fe7]/15 text-[#4a8fe7] px-2 py-0.5">{peerCountBySection[s]} teoria</span>
                  <span class="rounded-full bg-[#ef4444]/15 text-[#ef4444] px-2 py-0.5">{unpeerCountBySection[s]} realtà</span>
                </span>
              </span>
              <span class="text-xs d-text-dim transition-transform">▼</span>
            </button>
            <div class="vault-section-body divide-y divide-stone-100 dark:d-border">
              {entriesBySection[s].map(e => (
                <a href={`/${e.slug}/`} class="vault-entry flex items-center gap-4 px-5 py-3.5 hover:bg-stone-50 dark:d-hover transition-colors text-sm group" data-slug={e.slug} data-tags={e.tags.join(",")}>
                  <span class="w-3 h-3 rounded-full shrink-0" style={e.hasUnpeeragogy ? "background:#ef4444" : "background:#4a8fe7"}></span>
                  <span class="flex-1 font-medium text-[15px]">{e.title}</span>
                  {e.tension !== null && (
                    <span class="tension-badge text-xs px-2 py-1 rounded-full shrink-0 font-medium" style={e.tension >= 1.0 ? "background:rgba(239,68,68,0.15);color:#f87171" : e.tension >= 0.6 ? "background:rgba(249,115,22,0.15);color:#fb923c" : "background:rgba(74,143,231,0.15);color:#4a8fe7"}>
                      T {e.tension.toFixed(1)}
                    </span>
                  )}
                  <span class="text-xs d-text-dim w-8 text-right shrink-0">{e.readingTime}m</span>
                  <span class="d-text-dim group-hover:translate-x-1 transition-transform shrink-0">→</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import * as d3 from "d3-force";

  let sim = null;
  let canvas = null;
  let ctx = null;
  let zoomState = { x: 0, y: 0, k: 1 };
  let showLabels = true;
  let mousePos = { x: -1, y: -1 };
  let cachedFont = null;
  let cachedFontSize = -1;
  let hiddenSections = new Set();
  let hiddenGroups = new Set();
  let visitedSlugs = new Set();

  function getNodeColor(n) {
    return n.sectionColor || "#a1a1aa";
  }

  function getCSSVar(name, fallback) {
    return getComputedStyle(document.body).getPropertyValue(name).trim() || fallback;
  }

  // ---- Init ----
  function initGraph() {
    let container = document.getElementById("force-graph");
    if (!container) return;
    if (sim) { sim.stop(); sim = null; }
    if (canvas) { canvas.remove(); canvas = null; ctx = null; }

    canvas = document.createElement("canvas");
    canvas.style.width = "100%";
    canvas.style.height = "100%";
    canvas.style.display = "block";
    container.appendChild(canvas);
    ctx = canvas.getContext("2d");

    let ro = new ResizeObserver(function() { resize(); });
    ro.observe(container);
    resize();

    let vaultData = JSON.parse(document.getElementById("vault-data").textContent);
    let nodes = vaultData.nodes.map(function(n) { return { ...n }; });
    let links = vaultData.links.map(function(l) { 
      var link = { source: l.source, target: l.target, type: l.type };
      if (l.weight) link.weight = l.weight;
      if (l.sharedTags) link.sharedTags = l.sharedTags;
      return link;
    });

    // Load visited from localStorage + mark current page
    visitedSlugs = new Set(JSON.parse(localStorage.getItem("graph-visited") || "[]"));
    let currentSlug = window.location.pathname.replace(/^\//, "").replace(/\/$/, "");
    if (currentSlug && currentSlug !== "vault") visitedSlugs.add(currentSlug);

    let w = canvas.width, h = canvas.height;
    // Initial positions: random around center (Quartz-style)
    nodes.forEach(function(n) {
      n.x = Math.random() * w * 0.6 + w * 0.2;
      n.y = Math.random() * h * 0.6 + h * 0.2;
    });

    // Force simulation — PARAMETRI QUARTZ (deboli)
    sim = d3.forceSimulation(nodes)
      .force("link", d3.forceLink(links).id(function(d) { return d.id; }).distance(50).strength(0.2))
      .force("charge", d3.forceManyBody().strength(-60))
      .force("center", d3.forceCenter(w / 2, h / 2).strength(0.3))
      .force("collide", d3.forceCollide(12))
      .alphaDecay(0.03)
      .velocityDecay(0.4);

    sim.on("tick", render);
    sim.on("end", zoomToFit);

    // Stop + fit after 4s
    setTimeout(function() {
      if (sim) { sim.alphaTarget(0); sim.stop(); zoomToFit(); }
    }, 4000);

    // ---- Interactivity ----
    let dragNode = null, isPan = false, last = { x:0, y:0 };

    canvas.addEventListener("wheel", function(e) {
      e.preventDefault();
      let ok = zoomState.k;
      zoomState.k *= Math.pow(1.001, -e.deltaY);
      zoomState.k = Math.max(0.2, Math.min(6, zoomState.k));
      zoomState.x = e.offsetX - (e.offsetX - zoomState.x) * (zoomState.k / ok);
      zoomState.y = e.offsetY - (e.offsetY - zoomState.y) * (zoomState.k / ok);
      requestAnimationFrame(render);
    });

    canvas.addEventListener("mousedown", function(e) {
      let n = hitTest(e.offsetX, e.offsetY);
      if (n) { dragNode = n; sim.alphaTarget(0.3).restart(); }
      else { isPan = true; last = { x: e.offsetX, y: e.offsetY }; }
    });

    canvas.addEventListener("mousemove", function(e) {
      mousePos = { x: e.offsetX, y: e.offsetY };
      if (dragNode) {
        let p = screenToGraph(e.offsetX, e.offsetY);
        dragNode.fx = p.x; dragNode.fy = p.y;
        sim.alpha(0.1).restart();
      } else if (isPan) {
        zoomState.x += e.offsetX - last.x;
        zoomState.y += e.offsetY - last.y;
        last = { x: e.offsetX, y: e.offsetY };
        requestAnimationFrame(render);
      } else {
        canvas.style.cursor = hitTest(e.offsetX, e.offsetY) ? "pointer" : "default";
      }
    });

    canvas.addEventListener("mouseup", function(e) {
      if (dragNode) {
        dragNode.fx = null; dragNode.fy = null;
        if (hitTest(e.offsetX, e.offsetY) === dragNode) {
          visitedSlugs.add(dragNode.id);
          localStorage.setItem("graph-visited", JSON.stringify(Array.from(visitedSlugs)));
          window.location.href = "/" + dragNode.id + "/";
        }
        dragNode = null;
      }
      isPan = false;
      sim.alphaTarget(0);
    });

    canvas.addEventListener("mouseleave", function() {
      dragNode = null; isPan = false; mousePos = { x: -1, y: -1 };
      sim.alphaTarget(0);
    });

    canvas.addEventListener("dblclick", zoomToFit);

    let ci = document.getElementById("ctrl-zoom-in");
    let co = document.getElementById("ctrl-zoom-out");
    let cr = document.getElementById("ctrl-reset");
    let cl = document.getElementById("ctrl-labels");
    if (ci) ci.onclick = function() { zoomState.k = Math.min(6, zoomState.k * 1.3); render(); };
    if (co) co.onclick = function() { zoomState.k = Math.max(0.2, zoomState.k / 1.3); render(); };
    if (cr) cr.onclick = zoomToFit;
    if (cl) cl.onclick = function() { showLabels = !showLabels; render(); };
  }

  // ---- Geometry ----
  function getNodeRadius(n) {
    let base = 5;
    let degreeBonus = 0;
    if (sim) {
      let links = sim.force("link").links();
      let count = 0;
      for (let i = 0; i < links.length; i++) {
        let l = links[i];
        let sid = typeof l.source === "object" ? l.source.id : l.source;
        let tid = typeof l.target === "object" ? l.target.id : l.target;
        if (sid === n.id || tid === n.id) count++;
      }
      degreeBonus = Math.sqrt(count) * 2;
    }
    let tensionBonus = (n.tension && n.tension > 0) ? n.tension * 2 : 0;
    return Math.max(5, Math.min(16, base + degreeBonus + tensionBonus));
  }

  function screenToGraph(sx, sy) {
    return { x: (sx - zoomState.x) / zoomState.k, y: (sy - zoomState.y) / zoomState.k };
  }

  function hitTest(sx, sy) {
    if (!sim) return null;
    let p = screenToGraph(sx, sy);
    let nodes = sim.nodes();
    for (let i = nodes.length - 1; i >= 0; i--) {
      let n = nodes[i];
      let r = getNodeRadius(n);
      let dx = p.x - n.x, dy = p.y - n.y;
      if (dx * dx + dy * dy <= (r + 3) * (r + 3)) return n;
    }
    return null;
  }

  function zoomToFit() {
    if (!sim || !canvas) return;
    let nodes = sim.nodes(); if (!nodes.length) return;
    let w = canvas.width, h = canvas.height;
    let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
    nodes.forEach(function(n) {
      if (hiddenSections.has(n.section)) return;
      let r = getNodeRadius(n);
      if (n.x - r < minX) minX = n.x - r;
      if (n.x + r > maxX) maxX = n.x + r;
      if (n.y - r < minY) minY = n.y - r;
      if (n.y + r > maxY) maxY = n.y + r;
    });
    if (minX === Infinity) return; // all hidden
    let gw = Math.max(maxX - minX, 10);
    let gh = Math.max(maxY - minY, 10);
    let pad = 50;
    zoomState.k = Math.min((w - pad * 2) / gw, (h - pad * 2) / gh, 3);
    zoomState.k = Math.max(0.3, zoomState.k);
    zoomState.x = w / 2 - (minX + maxX) / 2 * zoomState.k;
    zoomState.y = h / 2 - (minY + maxY) / 2 * zoomState.k;
    requestAnimationFrame(render);
  }

  function resize() {
    let container = document.getElementById("force-graph");
    if (!container || !canvas) return;
    let w = container.clientWidth || 800;
    let h = container.clientHeight || 620;
    canvas.width = w;
    canvas.height = h;
    canvas.style.width = w + "px";
    canvas.style.height = h + "px";
    cachedFont = null;
    if (sim) zoomToFit();
  }

  // ---- Render ----
  function render() {
    if (!ctx || !sim) return;
    let w = canvas.width, h = canvas.height;
    let isDark = document.documentElement.classList.contains("dark");

    // Clear
    ctx.fillStyle = getCSSVar("--color-bg", "#ffffff");
    ctx.fillRect(0, 0, w, h);

    ctx.save();
    ctx.translate(zoomState.x, zoomState.y);
    ctx.scale(zoomState.k, zoomState.k);

    // Links (styled by type, weighted by tension)
    let linkAlpha = isDark ? 0.35 : 0.2;
    let nodes = sim.nodes();
    let nmap = {};
    nodes.forEach(function(n) { nmap[n.id] = n; });
    let visibleNodes = new Set();
    nodes.forEach(function(n) { if (!hiddenSections.has(n.section) && !hiddenGroups.has(n.group)) visibleNodes.add(n.id); });
    let links = sim.force("link").links();
    links.forEach(function(l) {
      let s = typeof l.source === "object" ? l.source : nmap[l.source];
      let t = typeof l.target === "object" ? l.target : nmap[l.target];
      if (!s || !t) return;
      if (!visibleNodes.has(s.id) || !visibleNodes.has(t.id)) return;
      let alpha = linkAlpha;
      let width = 1;
      let color = isDark ? "200, 210, 230" : "100, 110, 130";
      if (l.type && l.type.startsWith("tag-")) { alpha = linkAlpha * 1.5; width = 1.2; }
      else if (l.type === "bridge") { alpha = linkAlpha * 0.7; width = 0.8; }
      else if (l.type === "tension") {
        color = "239, 68, 68";
        alpha = linkAlpha * 1.8;
        // Weighted by shared-tag count
        let w = l.weight || 1;
        width = Math.min(1.0 + w * 0.4, 3.0);
      }
      ctx.strokeStyle = "rgba(" + color + "," + alpha + ")";
      ctx.lineWidth = width / zoomState.k;
      ctx.beginPath();
      ctx.moveTo(s.x, s.y);
      ctx.lineTo(t.x, t.y);
      ctx.stroke();
    });

    // Nodes (draw unpeeragogy inner dot on top, skip hidden sections)
    nodes.forEach(function(n) {
      if (hiddenSections.has(n.section)) return;
      let r = getNodeRadius(n);
      let isVisited = visitedSlugs.has(n.id);
      let alpha = isVisited ? 1.0 : 0.35;
      ctx.globalAlpha = alpha;
      ctx.beginPath();
      ctx.arc(n.x, n.y, r, 0, 2 * Math.PI);
      ctx.fillStyle = getNodeColor(n);
      ctx.fill();
      ctx.strokeStyle = "rgba(255,255,255,0.7)";
      ctx.lineWidth = 2 / zoomState.k;
      ctx.stroke();
      // Inner dot: red if has unpeeragogy, blue-ish if theory-only
      ctx.beginPath();
      ctx.arc(n.x, n.y, 3, 0, 2 * Math.PI);
      ctx.fillStyle = n.group === "unpeeragogy" || n.group === "unpeeragogy-only" ? "#ef4444" : "#3b82f6";
      ctx.fill();
      ctx.globalAlpha = 1.0;
    });

    // Labels
    if (showLabels) {
      let fs = Math.max(8, 12 / Math.pow(zoomState.k, 0.5));
      if (fs !== cachedFontSize) { cachedFont = fs + "px sans-serif"; cachedFontSize = fs; }
      ctx.font = cachedFont;
      ctx.textAlign = "center";
      ctx.textBaseline = "top";
      nodes.forEach(function(n) {
        if (hiddenSections.has(n.section)) return;
        let r = getNodeRadius(n);
        let label = n.name.length > 18 ? n.name.slice(0, 18) + "…" : n.name;
        let isVisited = visitedSlugs.has(n.id);
        ctx.globalAlpha = isVisited ? 0.9 : 0.35;
        let lx = n.x, ly = n.y + r + 2;
        // Halo outline — leggibile su qualsiasi sfondo (chiaro e scuro)
        ctx.strokeStyle = isDark ? "rgba(0,0,0,0.6)" : "rgba(255,255,255,0.8)";
        ctx.lineWidth = Math.max(1, 3 / zoomState.k);
        ctx.lineJoin = "round";
        ctx.strokeText(label, lx, ly);
        ctx.fillStyle = isDark ? "rgba(230,235,245,0.85)" : "rgba(25,30,40,0.8)";
        ctx.fillText(label, lx, ly);
      });
      ctx.globalAlpha = 1.0;
    }

    ctx.restore();

    // Tooltip (fixed position, not affected by zoom)
    if (mousePos.x >= 0) {
      let hit = hitTest(mousePos.x, mousePos.y);
      if (hit) {
        let label = hit.name + " · " + (hit.section || "");
        if (hit.tension !== null) label += "  T:" + hit.tension.toFixed(1);
        ctx.font = "13px sans-serif";
        let tw = ctx.measureText(label).width;
        let pad = 10;
        let bx = mousePos.x + 14, by = mousePos.y - 16;
        if (bx + tw + pad > w) bx = mousePos.x - tw - pad - 14;
        ctx.fillStyle = getCSSVar("--surface-raised", "#ffffff");
        ctx.strokeStyle = getCSSVar("--border-default", "#e4e4e7");
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.roundRect(bx, by, tw + pad * 2, 26, 6);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = getCSSVar("--color-text", "#18181b");
        ctx.textBaseline = "middle";
        ctx.fillText(label, bx + pad, by + 13);
      }
    }
  }

  // --- View switching ---
  document.addEventListener("DOMContentLoaded", function() {
    let gBtn = document.getElementById("view-graph-btn");
    let tBtn = document.getElementById("view-tree-btn");
    if (gBtn) {
      gBtn.addEventListener("click", function() {
        document.getElementById("vault-graph").classList.remove("hidden");
        document.getElementById("vault-tree").classList.add("hidden");
        this.className = "rounded-md px-4 py-2 text-sm transition-all bg-white dark:d-raised shadow-sm font-semibold text-(--color-accent)";
        let other = document.getElementById("view-tree-btn");
        if (other) other.className = "rounded-md px-4 py-2 text-sm transition-all d-text-sec";
        initGraph();
      });
    }
    if (tBtn) {
      tBtn.addEventListener("click", function() {
        document.getElementById("vault-graph").classList.add("hidden");
        document.getElementById("vault-tree").classList.remove("hidden");
        this.className = "rounded-md px-4 py-2 text-sm transition-all bg-white dark:d-raised shadow-sm font-semibold text-(--color-accent)";
        let other = document.getElementById("view-graph-btn");
        if (other) other.className = "rounded-md px-4 py-2 text-sm transition-all d-text-sec";
      });
    }
  });

  // --- Accordion ---
  document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll(".vault-section-header").forEach(function(btn) {
      btn.addEventListener("click", function() {
        this.closest(".vault-section").classList.toggle("collapsed");
      });
    });
  });

  // --- Search ---
  document.addEventListener("DOMContentLoaded", function() {
    let searchInput = document.getElementById("vault-search");
    if (searchInput) {
      searchInput.addEventListener("input", function() {
        let q = this.value.toLowerCase();
        document.querySelectorAll(".vault-entry").forEach(function(el) {
          el.style.display = el.textContent.toLowerCase().includes(q) ? "" : "none";
        });
        document.querySelectorAll(".vault-section").forEach(function(el) {
          let visible = false;
          el.querySelectorAll(".vault-entry").forEach(function(e) { if (e.style.display !== "none") visible = true; });
          el.style.display = visible ? "" : "none";
        });
      });
    }
  });

  // --- Tag filter ---
  document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll(".tag-filter").forEach(function(btn) {
      btn.addEventListener("click", function() {
        let tag = this.dataset.tag;
        document.querySelectorAll(".tag-filter").forEach(function(b) {
          b.className = b.dataset.tag === tag
            ? "tag-filter active rounded-full px-3 py-1 text-xs font-medium bg-(--color-accent) text-white"
            : "tag-filter rounded-full px-3 py-1 text-xs font-medium bg-stone-100 dark:d-surface d-text-sec hover:bg-stone-200 dark:d-hover transition-colors";
        });
        document.querySelectorAll(".vault-entry").forEach(function(el) {
          el.style.display = tag === "all" ? "" : (el.dataset.tags || "").includes(tag) ? "" : "none";
        });
        document.querySelectorAll(".vault-section").forEach(function(el) {
          let visible = false;
          el.querySelectorAll(".vault-entry").forEach(function(e) { if (e.style.display !== "none") visible = true; });
          el.style.display = visible ? "" : "none";
        });
      });
    });
  });

  // Init graph after DOM ready
  document.addEventListener("DOMContentLoaded", function() {
    setTimeout(initGraph, 300);
  });

  // --- All toggle (Tutti) ---
  document.addEventListener("DOMContentLoaded", function() {
    var allBtn = document.querySelector('.group-filter[data-group="all"]');
    if (allBtn) {
      allBtn.addEventListener("click", function() {
        var isAllActive = this.classList.contains("active");
        if (isAllActive) {
          // Deselect all section filters
          hiddenSections = new Set(sectionOrder);
          document.querySelectorAll(".section-filter").forEach(function(btn) {
            btn.classList.remove("active");
          });
        } else {
          // Select all section filters
          hiddenSections = new Set();
          document.querySelectorAll(".section-filter").forEach(function(btn) {
            btn.classList.add("active");
          });
        }
        this.classList.toggle("active");
        if (sim) zoomToFit();
      });
    }
  });

  // --- Section filter ---
  document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll(".section-filter").forEach(function(btn) {
      btn.addEventListener("click", function() {
        var sec = this.dataset.section;
        var isActive = this.classList.contains("active");
        this.classList.toggle("active");
        if (isActive) {
          hiddenSections.add(sec);
        } else {
          hiddenSections.delete(sec);
        }
        // Sync "Tutti" state
        var allBtn = document.querySelector('.group-filter[data-group="all"]');
        if (allBtn) {
          var allVisible = document.querySelectorAll(".section-filter.active").length === sectionOrder.length;
          allBtn.classList.toggle("active", allVisible);
        }
        if (sim) zoomToFit();
      });
    });
  });
</script>

<style is:global>
  .collapsed .vault-section-body { display: none; }
  .collapsed .vault-section-header span:last-child { transform: rotate(180deg); }
  .vault-section-header span:last-child { transition: transform 0.2s; }
  .vault-entry { text-decoration: none; color: inherit; }
  .vault-entry:hover { text-decoration: none; }
  .section-filter:not(.active) { opacity: 0.45; filter: saturate(0.3); }
