---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  return [{ params: {}, props: {} }];
}

const peeragogyEntries = await getCollection("peeragogy");
const unpeeragogyEntries = await getCollection("unpeeragogy");

// Sections
const sections = new Map();
for (const entry of peeragogyEntries) {
  const section = entry.data.section || "Altri";
  if (!sections.has(section)) sections.set(section, []);
  sections.get(section).push(entry);
}
for (const [, entries] of sections) {
  entries.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
}

// Tag index
const allTags = new Set();
for (const entry of [...peeragogyEntries, ...unpeeragogyEntries]) {
  if (entry.data.tags) entry.data.tags.forEach(t => allTags.add(t));
}

// Section order
const sectionOrder = Array.from(sections.keys()).sort((a, b) => {
  const aMin = Math.min(...sections.get(a).map(e => e.data.order || 99));
  const bMin = Math.min(...sections.get(b).map(e => e.data.order || 99));
  return aMin - bMin;
});

// Section palette (9 handbook sections + fallback)
const sectionColors = {
  "Peeragogy in Practice":                  "#6366f1",
  "Resources":                              "#8b5cf6",
  "Cooperation":                            "#06b6d4",
  "Convening a Group":                      "#d946ef",
  "Introduction":                           "#10b981",
  "Organizing a Learning Context":          "#f59e0b",
  "Technologies, Services, and Platforms":  "#f97316",
  "Motivation":                             "#ec4899",
  "Assessment":                             "#84cc16",
  "Altri":                                  "#a1a1aa",
};
const sectionMap = Object.fromEntries(
  sectionOrder.map(s => [s, { color: sectionColors[s] || "#a1a1aa", order: sectionOrder.indexOf(s) }])
);

// Mobile legend abbreviations
const MOBILE_ABBR = {
  "Introduction": "Intr",
  "Motivation": "Motiv",
  "Peeragogy in Practice": "Pract",
  "Convening a Group": "Group",
  "Organizing a Learning Context": "Orgnz",
  "Cooperation": "Coop",
  "Assessment": "Asses",
  "Technologies, Services, and Platforms": "Tech",
  "Resources": "Res",
};

// Build 3D graph data — topology: within-section + paired cross-links
const graphNodes = [];
const graphLinks = [];
const nodeMap = new Map();

for (const pe of peeragogyEntries) {
  const ue = unpeeragogyEntries.find(e => e.slug === pe.slug);
  const sec = pe.data.section || "Altri";
  const node = {
    id: pe.slug,
    name: pe.data.title || pe.slug,
    group: ue ? "unpeeragogy" : "peeragogy",
    val: ue ? 2 : 1,
    tension: ue?.data?.tension_index ?? null,
    section: sec,
    sectionColor: sectionColors[sec] || "#a1a1aa",
    readingTime: pe.data.readingTime ?? 0,
  };
  nodeMap.set(pe.slug, node);
  graphNodes.push(node);
}

// Add unpeeragogy-only entries
for (const ue of unpeeragogyEntries) {
  if (!peeragogyEntries.find(e => e.slug === ue.slug)) {
    const sec = ue.data.section || "Altri";
    const node = {
      id: ue.slug,
      name: ue.data.title || ue.slug,
      group: "unpeeragogy-only",
      val: 2,
      tension: ue.data.tension_index ?? null,
      origin: ue.data.origin || "seed",
      section: sec,
      sectionColor: sectionColors[sec] || "#a1a1aa",
      readingTime: ue.data.readingTime ?? 0,
    };
    nodeMap.set(ue.slug, node);
    graphNodes.push(node);
  }
}

// Edges: within-section ordering (chain each section)
for (const [, entries] of sections) {
  for (let i = 0; i < entries.length - 1; i++) {
    graphLinks.push({ source: entries[i].slug, target: entries[i + 1].slug, type: "chain" });
  }
}

// Bridge edges: last node of section N → first node of section N+1
for (let i = 0; i < sectionOrder.length - 1; i++) {
  const cur = sections.get(sectionOrder[i]);
  const next = sections.get(sectionOrder[i + 1]);
  if (cur && cur.length > 0 && next && next.length > 0) {
    graphLinks.push({ source: cur[cur.length - 1].slug, target: next[0].slug, type: "bridge" });
  }
}

// Tag-based chain edges (structural tags with 3-15 nodes, avoids hairball)
const tagGroups = new Map();
for (const pe of peeragogyEntries) {
  if (pe.data.tags) {
    for (const tag of pe.data.tags) {
      if (!tagGroups.has(tag)) tagGroups.set(tag, []);
      tagGroups.get(tag).push(pe.slug);
    }
  }
}
for (const [tag, slugs] of tagGroups) {
  if (slugs.length >= 3 && slugs.length <= 15) {
    for (let i = 0; i < slugs.length - 1; i++) {
      graphLinks.push({ source: slugs[i], target: slugs[i + 1], type: "tag-" + tag });
    }
  }
}

// Map tags per slug (combining peer + unpeer for cross-section tag matching)
const nodeTags = {};
for (const pe of peeragogyEntries) {
  const tags = new Set();
  if (pe.data.tags) pe.data.tags.forEach(t => tags.add(t));
  const ue = unpeeragogyEntries.find(e => e.slug === pe.slug);
  if (ue && ue.data.tags) ue.data.tags.forEach(t => tags.add(t));
  if (tags.size > 0) nodeTags[pe.slug] = Array.from(tags);
}
for (const ue of unpeeragogyEntries) {
  if (!peeragogyEntries.find(e => e.slug === ue.slug) && ue.data.tags) {
    nodeTags[ue.slug] = ue.data.tags;
  }
}

// Tension-proximity edges: cross-section nodes with similar tension AND shared tags
const tensionNodes = graphNodes
  .filter(n => n.tension !== null && n.tension > 0)
  .sort((a, b) => a.tension - b.tension);
for (let i = 0; i < tensionNodes.length; i++) {
  for (let j = i + 1; j < tensionNodes.length; j++) {
    const a = tensionNodes[i];
    const b = tensionNodes[j];
    if (b.tension - a.tension > 0.3) break; // sorted, so stop early
    if (a.section !== b.section) {
      // Only connect if nodes share at least one semantic tag (not base)
      const aTags = nodeTags[a.id] || [];
      const bTags = nodeTags[b.id] || [];
      const baseTags = new Set(["unpeeragogy", "decostruzione", "anti-pattern"]);
      const shared = aTags.filter(t => bTags.includes(t) && !baseTags.has(t));
      if (shared.length > 0) {
        graphLinks.push({ source: a.id, target: b.id, type: "tension", weight: shared.length, sharedTags: shared });
        break; // at most one tension link per node
      }
    }
  }
}

// Tree data
const allTagsSorted = Array.from(allTags).sort();
const entriesBySection = {};
const peerCountBySection = {};
const unpeerCountBySection = {};

for (const s of sectionOrder) {
  entriesBySection[s] = sections.get(s).map(pe => {
    const ue = unpeeragogyEntries.find(e => e.slug === pe.slug);
    return {
      slug: pe.slug,
      title: pe.data.title || pe.slug,
      tension: ue?.data?.tension_index ?? null,
      origin: ue?.data?.origin || "seed",
      readingTime: pe.data.readingTime ?? 0,
      tags: pe.data.tags || [],
      hasUnpeeragogy: !!ue,
    };
  });
  peerCountBySection[s] = sections.get(s).length;
  unpeerCountBySection[s] = unpeeragogyEntries.filter(e =>
    sections.get(s).some(pe => pe.slug === e.slug)
  ).length;
}
---

<BaseLayout title="Vault — Unpeeragogy Knowledge Base" description="Interactive 3D graph + tree navigation of the Unpeeragogy knowledge base.">
  <script set:html={JSON.stringify({ nodes: graphNodes, links: graphLinks, sections: sectionMap })} id="vault-data" type="application/json"></script>
  <script src="../scripts/vault-d3-loader.ts"></script>
  <section class="py-4 sm:py-8">
    <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 mb-6">
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">🗂️ Knowledge Base</h1>
      <span class="rounded-full bg-stone-100 dark:bg-(--surface-bg) text-stone-600 dark:text-stone-300 px-3 py-1 text-xs sm:text-sm w-fit">{graphNodes.length} nodes · {graphLinks.length} connections</span>
    </div>

    <!-- Vault guide -->
    <details class="mb-6 group">
      <summary class="flex items-center gap-2 text-xs sm:text-sm d-text-dim cursor-pointer px-3 py-2 rounded-lg hover:bg-stone-100 dark:d-hover transition-colors w-fit">
        <span class="transition-transform group-open:rotate-90">▶</span>
        How to read the Vault
      </summary>
      <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 text-xs sm:text-sm p-4 border border-stone-200 d-border rounded-lg bg-white d-surface">
        <div class="space-y-1">
          <span class="font-semibold text-(--color-accent)">📖 Blue nodes</span>
          <p class="d-text-dim">Peeragogy Handbook patterns. The theory as-is.</p>
        </div>
        <div class="space-y-1">
          <span class="font-semibold text-amber-600 dark:text-amber-400">⚡ Amber nodes</span>
          <p class="d-text-dim">Unpeeragogy observations. Where theory meets friction.</p>
        </div>
        <div class="space-y-1">
          <span class="font-semibold">📏 Node size</span>
          <p class="d-text-dim"><code>tension_index</code>: larger = more observed friction.</p>
        </div>
        <div class="space-y-1">
          <span class="font-semibold">🎨 Section color</span>
          <p class="d-text-dim">Each color corresponds to a Peeragogy section.</p>
        </div>
        <div class="space-y-1">
          <span class="font-semibold">🏷️ Origin badge</span>
          <p class="d-text-dim"><em>Seed</em> = project analysis. <em>Field Report</em> = external contribution. Every entry shows where it comes from.</p>
        </div>
      </div>
      <p class="mt-2 text-xs d-text-dim italic">Suggested: Introduction → Motivation → Patterns → Convening</p>
    </details>

    <div class="flex items-center gap-2 mb-6 p-2 bg-stone-100 dark:d-surface rounded-lg w-full sm:w-fit">
      <button id="view-graph-btn" class="flex-1 sm:flex-initial rounded-md px-4 py-2 text-xs sm:text-sm transition-all bg-white dark:d-raised shadow-sm font-semibold text-(--color-accent)">🕸️ 3D Graph</button>
      <button id="view-tree-btn" class="flex-1 sm:flex-initial rounded-md px-4 py-2 text-xs sm:text-sm transition-all text-stone-600 dark:d-text-sec hover:text-(--color-text)">🌲 Tree</button>
    </div>

    <!-- Section filters (graph only) -->
    <div id="graph-filters" class="mb-4">
      <!-- Mobile toggle -->
      <button id="filter-toggle" class="sm:hidden flex items-center gap-2 text-xs d-text-dim mb-2 px-3 py-1.5 rounded-md hover:bg-stone-100 dark:d-hover transition-colors w-full">
        <span>☰ Section filters</span>
        <span class="ml-auto text-xs opacity-50">▼</span>
      </button>
      <div id="filter-body" class="flex flex-wrap gap-2">
        <div class="flex gap-1 mr-2 pr-2 border-r border-stone-200 dark:d-border">
          <button class="group-filter active rounded-md px-3 py-1 text-xs font-medium bg-(--color-accent) text-white" data-group="all">Tutti</button>
          <button class="group-filter rounded-md px-3 py-1 text-xs font-medium bg-stone-100 dark:d-surface text-stone-600 dark:d-text-sec hover:bg-stone-200 dark:d-hover transition-colors" data-group="unpeeragogy">⚡ Friction</button>
          <button class="group-filter rounded-md px-3 py-1 text-xs font-medium bg-stone-100 dark:d-surface text-stone-600 dark:d-text-sec hover:bg-stone-200 dark:d-hover transition-colors" data-group="peeragogy">📖 Teoria</button>
        </div>
        {sectionOrder.map(s => (
          <button class="section-filter active rounded-full px-2.5 py-1 text-xs font-medium flex items-center gap-1.5 bg-stone-100 dark:d-surface text-stone-600 dark:d-text-sec hover:bg-stone-200 dark:d-hover transition-colors border border-transparent" data-section={s} style={`border-color:${sectionColors[s] || "#a1a1aa"}`}>
            <span class="w-2.5 h-2.5 rounded-full" style={`background:${sectionColors[s] || "#a1a1aa"}`}></span>
            {s.replace(/^(Technologies,|Organizing a|Convening a) /, "").replace(/ Services, and Platforms$/, "")}
          </button>
        ))}
      </div>
    </div>

    <!-- 3D GRAPH -->
    <div id="vault-graph" class="w-full rounded-lg border border-stone-200 dark:d-border overflow-hidden" style="height:min(620px, calc(100vh - 14rem));position:relative;">
      <div id="force-graph" style="width:100%;height:100%;">
        <div id="graph-loading" class="absolute inset-0 flex items-center justify-center bg-(--color-bg) z-10 transition-opacity duration-500" style="pointer-events:none;">
          <div class="flex flex-col items-center gap-3">
            <div class="w-8 h-8 rounded-full border-2 border-(--color-accent) border-t-transparent animate-spin"></div>
            <span class="text-xs d-text-dim">Loading graph...</span>
          </div>
        </div>
      </div>
      <div id="graph-legend" class="absolute bottom-4 left-2 sm:left-4 flex flex-wrap gap-1 sm:gap-2 text-[10px] sm:text-xs bg-white/90 dark:bg-[var(--surface-bg)]/90 px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg shadow-sm dark:d-border backdrop-blur-sm max-w-[70%] sm:max-w-[60%]">
        {sectionOrder.slice(0, 6).map(s => (
          <span class="flex items-center gap-1 whitespace-nowrap" title={s}><span class="w-2 sm:w-3 h-2 sm:h-3 rounded-full inline-block" style={`background:${sectionColors[s] || "#a1a1aa"}`}></span> <span class="hidden sm:inline">{s.replace(/^(Technologies,|Organizing a|Convening a) /, "").replace(/ Services, and Platforms$/, "")}</span><span class="sm:hidden">{MOBILE_ABBR[s] || s.split(/\s+/).map(w => w[0]).join('').slice(0,4)}</span></span>
        ))}
        {sectionOrder.length > 6 && <span class="text-[10px] opacity-60">+{sectionOrder.length - 6}</span>}
        <span class="flex items-center gap-1 ml-1 pl-2 border-l border-stone-300 dark:d-border"><span class="w-1.5 sm:w-2 h-1.5 sm:h-2 rounded-full inline-block ring-1 ring-white dark:ring-black" style="background:#ffffff;border:2px solid currentColor;color:var(--color-text)"></span> <span class="text-[10px] sm:text-xs">Friction</span></span>
      </div>
      <div id="graph-controls" class="absolute bottom-4 right-2 sm:right-4 flex flex-col gap-1.5">
        <button id="ctrl-zoom-in" class="w-9 sm:w-10 h-9 sm:h-10 flex items-center justify-center rounded-xl bg-white/95 dark:bg-[var(--surface-bg)]/95 shadow-md dark:shadow-sm dark:d-border backdrop-blur-sm text-base sm:text-lg font-bold hover:bg-stone-100 dark:d-hover transition-all cursor-pointer select-none border border-stone-200 dark:border-0" title="Zoom +" aria-label="Zoom in">＋</button>
        <button id="ctrl-zoom-out" class="w-9 sm:w-10 h-9 sm:h-10 flex items-center justify-center rounded-xl bg-white/95 dark:bg-[var(--surface-bg)]/95 shadow-md dark:shadow-sm dark:d-border backdrop-blur-sm text-base sm:text-lg font-bold hover:bg-stone-100 dark:d-hover transition-all cursor-pointer select-none border border-stone-200 dark:border-0" title="Zoom -" aria-label="Zoom out">−</button>
        <button id="ctrl-reset" class="w-9 sm:w-10 h-9 sm:h-10 flex items-center justify-center rounded-xl bg-white/95 dark:bg-[var(--surface-bg)]/95 shadow-md dark:shadow-sm dark:d-border backdrop-blur-sm text-xs sm:text-sm hover:bg-stone-100 dark:d-hover transition-all cursor-pointer select-none border border-stone-200 dark:border-0" title="Reset" aria-label="Reset view">⟲</button>
        <button id="ctrl-labels" class="w-9 sm:w-10 h-9 sm:h-10 flex items-center justify-center rounded-xl bg-white/95 dark:bg-[var(--surface-bg)]/95 shadow-md dark:shadow-sm dark:d-border backdrop-blur-sm text-[10px] sm:text-xs hover:bg-stone-100 dark:d-hover transition-all cursor-pointer select-none border border-stone-200 dark:border-0" title="Etichette" aria-label="Toggle labels">Aa</button>
        <button id="ctrl-fullscreen" class="w-9 sm:w-10 h-9 sm:h-10 flex items-center justify-center rounded-xl bg-white/95 dark:bg-[var(--surface-bg)]/95 shadow-md dark:shadow-sm dark:d-border backdrop-blur-sm text-xs sm:text-sm hover:bg-stone-100 dark:d-hover transition-all cursor-pointer select-none border border-stone-200 dark:border-0" title="Vista completa" aria-label="Toggle full page">⛶</button>
      </div>
    </div>

    <!-- TREE -->
    <div id="vault-tree" class="hidden">
      <div class="mb-6 flex flex-col sm:flex-row gap-3 items-start sm:items-center">
        <input id="vault-search" type="text" placeholder="Cerca capitolo..." class="rounded-lg border border-stone-200 dark:d-border bg-white dark:[background:var(--surface-bg)] px-4 py-2.5 text-sm w-full sm:w-auto sm:flex-1 sm:max-w-sm" />
        <div class="flex flex-wrap gap-2" id="tag-filters">
          <button class="tag-filter active rounded-full px-3 py-1 text-xs font-medium bg-(--color-accent) text-white" data-tag="all">Tutti</button>
          {allTagsSorted.slice(0, 20).map(tag => <button class="tag-filter rounded-full px-3 py-1 text-xs font-medium bg-stone-100 dark:d-surface text-stone-600 dark:d-text-sec hover:bg-stone-200 dark:d-hover transition-colors" data-tag={tag}>#{tag}</button>)}
        </div>
      </div>

      <div class="space-y-3 sm:space-y-4" id="vault-tree-sections">
        {sectionOrder.map(s => (
          <div class="vault-section border border-stone-200 dark:d-border rounded-xl overflow-hidden" data-section={s}>
            <button class="vault-section-header w-full flex items-center justify-between px-4 sm:px-5 py-3 sm:py-4 bg-stone-50 dark:d-surface hover:bg-stone-100 dark:d-hover transition-colors text-left text-sm sm:text-base font-semibold">
              <span class="flex items-center gap-2 sm:gap-3 min-w-0">
                <span class="truncate">{s}</span>
                <span class="inline-flex items-center gap-1 sm:gap-1.5 text-xs font-normal shrink-0">
                  <span class="rounded-full bg-[#4a8fe7]/15 text-[#4a8fe7] px-2 py-0.5">{peerCountBySection[s]} teoria</span>
                  <span class="rounded-full bg-[#d97706]/15 text-amber-600 dark:text-amber-400 px-2 py-0.5">{unpeerCountBySection[s]} osservaz.</span>
                </span>
              </span>
              <span class="text-xs d-text-dim transition-transform shrink-0">▼</span>
            </button>
            <div class="vault-section-body divide-y divide-stone-100 dark:d-border">
              {entriesBySection[s].map(e => (
                <a href={`/${e.slug}/`} class="vault-entry flex items-center gap-2 sm:gap-4 px-4 sm:px-5 py-3 sm:py-3.5 hover:bg-stone-50 dark:d-hover transition-colors text-xs sm:text-sm group" data-slug={e.slug} data-tags={e.tags.join(",")}>
                  <span class="w-2.5 sm:w-3 h-2.5 sm:h-3 rounded-full shrink-0" style={e.hasUnpeeragogy ? "background:#ef4444" : "background:#4a8fe7"}></span>
                  <span class="flex-1 font-medium text-sm sm:text-[15px] min-w-0 truncate">{e.title}</span>
                  {e.origin && e.origin !== "seed" && (
                    <span class="text-[9px] sm:text-[10px] px-1.5 py-0.5 rounded-full shrink-0 font-medium bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300 mr-1">FR</span>
                  )}
                  {e.tension !== null && (
                    <span class="tension-badge text-[10px] sm:text-xs px-1.5 sm:px-2 py-0.5 sm:py-1 rounded-full shrink-0 font-medium hidden sm:inline-block" style={e.tension >= 1.0 ? "background:rgba(239,68,68,0.15);color:#f87171" : e.tension >= 0.6 ? "background:rgba(249,115,22,0.15);color:#fb923c" : "background:rgba(74,143,231,0.15);color:#4a8fe7"}>
                      T {e.tension.toFixed(1)}
                    </span>
                  )}
                  <span class="text-xs d-text-dim w-6 sm:w-8 text-right shrink-0">{e.readingTime}m</span>
                  <span class="d-text-dim group-hover:translate-x-1 transition-transform shrink-0 hidden sm:inline">→</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (async function(){
  var d3;
  // Load d3-force from Astro-bundled module (compiled from node_modules)
  // The bundled loader sets window.__d3GraphApi when ready
  function waitForD3(attempts) {
    if (attempts <= 0) return null;
    var api = window.__d3GraphApi;
    if (api && api.loaded) {
      return {
        forceSimulation: api.forceSimulation,
        forceLink: api.forceLink,
        forceManyBody: api.forceManyBody,
        forceCenter: api.forceCenter,
        forceCollide: api.forceCollide,
      };
    }
    // Module may still be loading — retry on next frame
    return new Promise(function(resolve) {
      requestAnimationFrame(function() {
        resolve(waitForD3(attempts - 1));
      });
    });
  }
  d3 = await waitForD3(30); // ~500ms budget for module load
  if (!d3) {
    console.warn("d3-force failed to load from bundle — graph will be disabled");
  }

  let sim = null;
  let canvas = null;
  let ctx = null;
  let zoomState = { x: 0, y: 0, k: 1 };
  let showLabels = true;
  let mousePos = { x: -1, y: -1 };
  let cachedFont = null;
  let cachedFontSize = -1;
  let hiddenSections = new Set();
  let hiddenGroups = new Set();
  let visitedSlugs = new Set();
  let ro = null; // ResizeObserver, disconnettibile
  let simEnded = false;
  let filterDirty = true; // rebuild nmap/visibleNodes only when filters change
  let cachedNmap = {};
  let cachedVisibleNodes = new Set();
  let cachedDegrees = {}; // degree per node id
  let prefersReducedMotion = false;
  if (typeof window !== 'undefined') {
    prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  let _cssCache = {};
  document.addEventListener("theme-changed", function() { _cssCache = {}; });
  function getCSSVar(name, fallback) {
    if (!_cssCache[name]) {
      _cssCache[name] = getComputedStyle(document.body).getPropertyValue(name).trim() || fallback;
      // Invalida dopo 1s (per theme switch)
      setTimeout(function() { delete _cssCache[name]; }, 1000);
    }
    return _cssCache[name];
  }

  // roundRect polyfill per Safari < 15.4
  if (!CanvasRenderingContext2D.prototype.roundRect) {
    CanvasRenderingContext2D.prototype.roundRect = function(x, y, w, h, r) {
      if (r > w / 2) r = w / 2;
      if (r > h / 2) r = h / 2;
      this.moveTo(x + r, y);
      this.lineTo(x + w - r, y);
      this.quadraticCurveTo(x + w, y, x + w, y + r);
      this.lineTo(x + w, y + h - r);
      this.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
      this.lineTo(x + r, y + h);
      this.quadraticCurveTo(x, y + h, x, y + h - r);
      this.lineTo(x, y + r);
      this.quadraticCurveTo(x, y, x + r, y);
      this.closePath();
      return this;
    };
  }

  function getNodeColor(n) {
    return n.sectionColor || "#a1a1aa";
  }

  // ---- Init ----
  function initGraph() {
    if (!d3) {
      console.warn("d3-force unavailable — graph disabled");
      let el = document.getElementById("graph-loading");
      if (el) {
        el.style.pointerEvents = "auto";
        el.innerHTML = '<div class="flex flex-col items-center gap-3 px-4 text-center"><span class="text-lg">🕸️</span><span class="text-xs d-text-dim">Graph unavailable · check connection</span></div>';
      }
      return;
    }
    let container = document.getElementById("force-graph");
    if (!container) return;
    // Don't init if container is hidden (no dimensions)
    if (container.offsetParent === null || container.clientWidth === 0) {
      return;
    }
    if (ro) { ro.disconnect(); ro = null; }
    if (sim) { sim.stop(); sim = null; }
    if (canvas) { canvas.remove(); canvas = null; ctx = null; }
    simEnded = false;
    filterDirty = true;

    canvas = document.createElement("canvas");
    canvas.style.width = "100%";
    canvas.style.height = "100%";
    canvas.style.display = "block";
    canvas.style.touchAction = "none";
    container.appendChild(canvas);
    ctx = canvas.getContext("2d");

    ro = new ResizeObserver(function() { resize(); });
    ro.observe(container);
    resize();

    let vaultData = JSON.parse(document.getElementById("vault-data").textContent);
    let nodes = vaultData.nodes.map(function(n) { return { ...n }; });
    let links = vaultData.links.map(function(l) { 
      var link = { source: l.source, target: l.target, type: l.type };
      if (l.weight) link.weight = l.weight;
      if (l.sharedTags) link.sharedTags = l.sharedTags;
      return link;
    });

    // Load visited from localStorage + mark current page
    visitedSlugs = new Set(JSON.parse(localStorage.getItem("graph-visited") || "[]"));
    let currentSlug = window.location.pathname.replace(/^\//, "").replace(/\/$/, "");
    if (currentSlug && currentSlug !== "vault") visitedSlugs.add(currentSlug);

    let w = canvas.width, h = canvas.height;
    // Initial positions: random around center (Quartz-style)
    nodes.forEach(function(n) {
      n.x = Math.random() * w * 0.6 + w * 0.2;
      n.y = Math.random() * h * 0.6 + h * 0.2;
    });

    // Force simulation — PARAMETRI QUARTZ (deboli)
    sim = d3.forceSimulation(nodes)
      .force("link", d3.forceLink(links).id(function(d) { return d.id; }).distance(50).strength(0.2))
      .force("charge", d3.forceManyBody().strength(-60))
      .force("center", d3.forceCenter(w / 2, h / 2).strength(0.3))
      .force("collide", d3.forceCollide(12))
      .alphaDecay(0.03)
      .velocityDecay(0.4);

    rebuildDegrees();

    let loadingHidden = false;
    function hideGraphLoading() {
      if (loadingHidden) return;
      loadingHidden = true;
      let el = document.getElementById("graph-loading");
      if (el) {
        el.style.opacity = "0";
        setTimeout(function() { if (el && el.parentNode) el.parentNode.removeChild(el); }, 500);
      }
    }

    sim.on("tick", function() { render(); hideGraphLoading(); });
    sim.on("end", function() {
      if (!simEnded) { simEnded = true; zoomToFit(); hideGraphLoading(); }
    });

    // Stop + fit after 4s (only if sim hasn't ended yet)
    setTimeout(function() {
      if (sim && !simEnded) { sim.alphaTarget(0); sim.stop(); simEnded = true; zoomToFit(); hideGraphLoading(); }
    }, 4000);

    // ---- Interactivity ----
    let dragNode = null, isPan = false, last = { x:0, y:0 };

    canvas.addEventListener("wheel", function(e) {
      e.preventDefault();
      let ok = zoomState.k;
      zoomState.k *= Math.pow(1.001, -e.deltaY);
      zoomState.k = Math.max(0.2, Math.min(6, zoomState.k));
      zoomState.x = e.offsetX - (e.offsetX - zoomState.x) * (zoomState.k / ok);
      zoomState.y = e.offsetY - (e.offsetY - zoomState.y) * (zoomState.k / ok);
      requestAnimationFrame(render);
    }, { passive: false });

    // ---- Touch events for mobile (scroll-aware with touch-action:none on canvas) ----
    // Canvas has touch-action:none, so browser never intercepts touch for scroll.
    // We still selectively preventDefault only when dragging/panning/zooming,
    // but the page scroll outside canvas works normally.
    let lastTouchDist = 0;
    let touchStartTime = 0;
    let touchMoved = false;
    let touchStartPos = { x: 0, y: 0 };
    const TAP_THRESHOLD = 10; // px movement before it's considered a drag/pan

    canvas.addEventListener("touchstart", function(e) {
      if (e.touches.length === 1) {
        var t = e.touches[0];
        var rect = canvas.getBoundingClientRect();
        var sx = t.clientX - rect.left, sy = t.clientY - rect.top;
        touchStartPos = { x: sx, y: sy };
        last = { x: sx, y: sy };
        touchStartTime = Date.now();
        touchMoved = false;
        var n = hitTest(sx, sy);
        if (n) {
          dragNode = n;
        } else {
          isPan = true;
        }
      } else if (e.touches.length === 2) {
        lastTouchDist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
      }
    });

    canvas.addEventListener("touchmove", function(e) {
      if (e.touches.length === 1) {
        var t = e.touches[0];
        var rect = canvas.getBoundingClientRect();
        var sx = t.clientX - rect.left, sy = t.clientY - rect.top;
        var dx = sx - touchStartPos.x;
        var dy = sy - touchStartPos.y;
        if (Math.abs(dx) > TAP_THRESHOLD || Math.abs(dy) > TAP_THRESHOLD) {
          touchMoved = true;
        }
        if (dragNode) {
          var p = screenToGraph(sx, sy);
          dragNode.fx = p.x; dragNode.fy = p.y;
          sim.alpha(0.1).restart();
        } else if (isPan && touchMoved) {
          zoomState.x += sx - last.x;
          zoomState.y += sy - last.y;
          last = { x: sx, y: sy };
          requestAnimationFrame(render);
        }
      } else if (e.touches.length === 2) {
        var dist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
        if (lastTouchDist > 0) {
          var scale = dist / lastTouchDist;
          zoomState.k = Math.max(0.2, Math.min(6, zoomState.k * scale));
          requestAnimationFrame(render);
        }
        lastTouchDist = dist;
      }
    });

    canvas.addEventListener("touchend", function(e) {
      if (!touchMoved && e.changedTouches.length === 1 && dragNode) {
        var t = e.changedTouches[0];
        var rect = canvas.getBoundingClientRect();
        var sx = t.clientX - rect.left, sy = t.clientY - rect.top;
        if (hitTest(sx, sy) === dragNode) {
          visitedSlugs.add(dragNode.id);
          localStorage.setItem("graph-visited", JSON.stringify(Array.from(visitedSlugs)));
          window.location.href = "/" + dragNode.id + "/";
        }
      }
      dragNode = null; isPan = false; lastTouchDist = 0; touchMoved = false;
    });

    canvas.addEventListener("mousedown", function(e) {
      let n = hitTest(e.offsetX, e.offsetY);
      if (n) { dragNode = n; sim.alphaTarget(0.3).restart(); }
      else { isPan = true; last = { x: e.offsetX, y: e.offsetY }; }
    });

    canvas.addEventListener("mousemove", function(e) {
      mousePos = { x: e.offsetX, y: e.offsetY };
      if (dragNode) {
        let p = screenToGraph(e.offsetX, e.offsetY);
        dragNode.fx = p.x; dragNode.fy = p.y;
        sim.alpha(0.1).restart();
      } else if (isPan) {
        zoomState.x += e.offsetX - last.x;
        zoomState.y += e.offsetY - last.y;
        last = { x: e.offsetX, y: e.offsetY };
        requestAnimationFrame(render);
      } else {
        canvas.style.cursor = hitTest(e.offsetX, e.offsetY) ? "pointer" : "default";
      }
    });

    canvas.addEventListener("mouseup", function(e) {
      if (dragNode) {
        dragNode.fx = null; dragNode.fy = null;
        if (hitTest(e.offsetX, e.offsetY) === dragNode) {
          visitedSlugs.add(dragNode.id);
          localStorage.setItem("graph-visited", JSON.stringify(Array.from(visitedSlugs)));
          window.location.href = "/" + dragNode.id + "/";
        }
        dragNode = null;
      }
      isPan = false;
      sim.alphaTarget(0);
    });

    canvas.addEventListener("mouseleave", function() {
      dragNode = null; isPan = false; mousePos = { x: -1, y: -1 };
      sim.alphaTarget(0);
    });

    canvas.addEventListener("dblclick", zoomToFit);

    let ci = document.getElementById("ctrl-zoom-in");
    let co = document.getElementById("ctrl-zoom-out");
    let cr = document.getElementById("ctrl-reset");
    let cl = document.getElementById("ctrl-labels");
    if (ci) ci.onclick = function() { zoomState.k = Math.min(6, zoomState.k * 1.3); render(); };
    if (co) co.onclick = function() { zoomState.k = Math.max(0.2, zoomState.k / 1.3); render(); };
    if (cr) cr.onclick = zoomToFit;
    if (cl) cl.onclick = function() { showLabels = !showLabels; render(); };
  }

  // ---- Geometry ----
  function rebuildDegrees() {
    if (!sim) return;
    let links = sim.force("link").links();
    cachedDegrees = {};
    for (let i = 0; i < links.length; i++) {
      let l = links[i];
      let sid = typeof l.source === "object" ? l.source.id : l.source;
      let tid = typeof l.target === "object" ? l.target.id : l.target;
      cachedDegrees[sid] = (cachedDegrees[sid] || 0) + 1;
      cachedDegrees[tid] = (cachedDegrees[tid] || 0) + 1;
    }
    filterDirty = true;
  }

  function getNodeRadius(n) {
    let base = 5;
    let degree = cachedDegrees[n.id] || 0;
    let degreeBonus = Math.sqrt(degree) * 2;
    let tensionBonus = (n.tension && n.tension > 0) ? n.tension * 2 : 0;
    return Math.max(5, Math.min(16, base + degreeBonus + tensionBonus));
  }

  function screenToGraph(sx, sy) {
    return { x: (sx - zoomState.x) / zoomState.k, y: (sy - zoomState.y) / zoomState.k };
  }

  function hitTest(sx, sy) {
    if (!sim) return null;
    let p = screenToGraph(sx, sy);
    let nodes = sim.nodes();
    for (let i = nodes.length - 1; i >= 0; i--) {
      let n = nodes[i];
      let r = getNodeRadius(n);
      let dx = p.x - n.x, dy = p.y - n.y;
      if (dx * dx + dy * dy <= (r + 3) * (r + 3)) return n;
    }
    return null;
  }

  let _zoomToFitPending = false;
  function zoomToFit() {
    if (!sim || !canvas || _zoomToFitPending) return;
    _zoomToFitPending = true;
    let nodes = sim.nodes(); if (!nodes.length) { _zoomToFitPending = false; return; }
    let w = canvas.width, h = canvas.height;
    let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
    nodes.forEach(function(n) {
      if (hiddenSections.has(n.section)) return;
      let r = getNodeRadius(n);
      if (n.x - r < minX) minX = n.x - r;
      if (n.x + r > maxX) maxX = n.x + r;
      if (n.y - r < minY) minY = n.y - r;
      if (n.y + r > maxY) maxY = n.y + r;
    });
    if (minX === Infinity) { _zoomToFitPending = false; return; } // all hidden
    let gw = Math.max(maxX - minX, 10);
    let gh = Math.max(maxY - minY, 10);
    let pad = 50;
    zoomState.k = Math.min((w - pad * 2) / gw, (h - pad * 2) / gh, 3);
    zoomState.k = Math.max(0.3, zoomState.k);
    zoomState.x = w / 2 - (minX + maxX) / 2 * zoomState.k;
    zoomState.y = h / 2 - (minY + maxY) / 2 * zoomState.k;
    requestAnimationFrame(function() { render(); _zoomToFitPending = false; });
  }

  function resize() {
    let container = document.getElementById("force-graph");
    if (!container || !canvas) return;
    // Skip resize if graph is hidden (tree view mode)
    if (container.offsetParent === null) return;
    let w = container.clientWidth || 800;
    let h = container.clientHeight || 620;
    canvas.width = w;
    canvas.height = h;
    canvas.style.width = w + "px";
    canvas.style.height = h + "px";
    cachedFont = null;
    if (sim) zoomToFit();
  }

  // ---- Render ----
  function render() {
    if (!ctx || !sim) return;
    let w = canvas.width, h = canvas.height;
    let isDark = document.documentElement.classList.contains("dark");

    // Rebuild nmap/visibleNodes only when filters change
    if (filterDirty) {
      let nodes = sim.nodes();
      cachedNmap = {};
      nodes.forEach(function(n) { cachedNmap[n.id] = n; });
      cachedVisibleNodes = new Set();
      nodes.forEach(function(n) { if (!hiddenSections.has(n.section) && !hiddenGroups.has(n.group)) cachedVisibleNodes.add(n.id); });
      filterDirty = false;
    }

    // Clear (cached CSS vars, no forced layout)
    let bgColor = getCSSVar("--color-bg", "#ffffff");
    ctx.fillStyle = bgColor;
    ctx.fillRect(0, 0, w, h);

    ctx.save();
    ctx.translate(zoomState.x, zoomState.y);
    ctx.scale(zoomState.k, zoomState.k);

    // Links (styled by type, weighted by tension)
    let linkAlpha = isDark ? 0.35 : 0.2;
    let nodes = sim.nodes();
    let nmap = cachedNmap;
    let visibleNodes = cachedVisibleNodes;
    let links = sim.force("link").links();
    links.forEach(function(l) {
      let s = typeof l.source === "object" ? l.source : nmap[l.source];
      let t = typeof l.target === "object" ? l.target : nmap[l.target];
      if (!s || !t) return;
      if (!visibleNodes.has(s.id) || !visibleNodes.has(t.id)) return;
      let alpha = linkAlpha;
      let width = 1;
      let color = isDark ? "200, 210, 230" : "100, 110, 130";
      if (l.type && l.type.startsWith("tag-")) { alpha = linkAlpha * 1.5; width = 1.2; }
      else if (l.type === "bridge") { alpha = linkAlpha * 0.7; width = 0.8; }
      else if (l.type === "tension") {
        color = "239, 68, 68";
        alpha = linkAlpha * 1.8;
        let w = l.weight || 1;
        width = Math.min(1.0 + w * 0.4, 3.0);
      }
      ctx.strokeStyle = "rgba(" + color + "," + alpha + ")";
      ctx.lineWidth = width / zoomState.k;
      ctx.beginPath();
      ctx.moveTo(s.x, s.y);
      ctx.lineTo(t.x, t.y);
      ctx.stroke();
    });

    // Nodes
    nodes.forEach(function(n) {
      if (hiddenSections.has(n.section)) return;
      let r = getNodeRadius(n);
      let isVisited = visitedSlugs.has(n.id);
      // Shape distinction: visited = filled circle, unvisited = circle with diagonal line
      ctx.globalAlpha = 1.0;
      ctx.beginPath();
      ctx.arc(n.x, n.y, r, 0, 2 * Math.PI);
      ctx.fillStyle = getNodeColor(n);
      ctx.globalAlpha = isVisited ? 1.0 : 0.5;
      ctx.fill();
      ctx.strokeStyle = "rgba(255,255,255,0.7)";
      ctx.lineWidth = 2 / zoomState.k;
      ctx.stroke();
      if (!isVisited) {
        // Diagonal line across unvisited nodes for colorblind-friendly distinction
        ctx.beginPath();
        ctx.moveTo(n.x - r * 0.4, n.y - r * 0.4);
        ctx.lineTo(n.x + r * 0.4, n.y + r * 0.4);
        ctx.strokeStyle = "rgba(200,200,200,0.5)";
        ctx.lineWidth = 2 / zoomState.k;
        ctx.stroke();
      }
      ctx.globalAlpha = 1.0;
      // Inner dot
      ctx.beginPath();
      ctx.arc(n.x, n.y, 3, 0, 2 * Math.PI);
      ctx.fillStyle = n.group === "unpeeragogy" || n.group === "unpeeragogy-only" ? "#ef4444" : "#3b82f6";
      ctx.fill();
    });

    // Labels with overlap avoidance (grid-based)
    if (showLabels) {
      let fs = Math.max(8, 12 / Math.pow(zoomState.k, 0.5));
      if (fs !== cachedFontSize) { cachedFont = fs + "px sans-serif"; cachedFontSize = fs; }
      ctx.font = cachedFont;
      ctx.textAlign = "center";
      ctx.textBaseline = "top";
      let labelSpaces = {}; // track occupied positions per grid cell
      let GRID_SIZE = 50; // px in graph coords
      nodes.forEach(function(n) {
        if (hiddenSections.has(n.section)) return;
        if (!visibleNodes.has(n.id)) return;
        let r = getNodeRadius(n);
        let label = n.name.length > 18 ? n.name.slice(0, 18) + "…" : n.name;
        let isVisited = visitedSlugs.has(n.id);
        ctx.globalAlpha = isVisited ? 0.9 : 0.35;
        let lx = n.x, ly = n.y + r + 2;
        // Grid-based overlap avoidance
        let gx = Math.round(lx / GRID_SIZE);
        let gy = Math.round(ly / GRID_SIZE);
        let key = gx + ":" + gy;
        if (labelSpaces[key]) {
          ly = labelSpaces[key];
        } else {
          labelSpaces[key] = ly;
        }
        ctx.strokeStyle = isDark ? "rgba(0,0,0,0.6)" : "rgba(255,255,255,0.8)";
        ctx.lineWidth = Math.max(1, 3 / zoomState.k);
        ctx.lineJoin = "round";
        ctx.strokeText(label, lx, ly);
        ctx.fillStyle = isDark ? "rgba(230,235,245,0.85)" : "rgba(25,30,40,0.8)";
        ctx.fillText(label, lx, ly);
      });
      ctx.globalAlpha = 1.0;
    }

    ctx.restore();

    // Tooltip (fixed position, not affected by zoom)
    if (mousePos.x >= 0) {
      let hit = hitTest(mousePos.x, mousePos.y);
      if (hit) {
        let label = hit.name + " · " + (hit.section || "");
        if (hit.tension !== null) label += "  T:" + hit.tension.toFixed(1);
        ctx.font = "13px sans-serif";
        let tw = ctx.measureText(label).width;
        let pad = 10;
        let bx = mousePos.x + 14, by = mousePos.y - 16;
        let twp = tw + pad * 2;
        let th = 26;
        // Edge clamping: keep tooltip fully on-canvas
        if (bx + twp > w) bx = Math.max(2, w - twp - 2);
        if (bx < 2) bx = 2;
        if (by + th > h) by = mousePos.y - th - 8;
        if (by < 2) by = 2;
        let surfBg = getCSSVar("--surface-raised", "#ffffff");
        let borderCol = getCSSVar("--border-default", "#e4e4e7");
        let txtCol = getCSSVar("--color-text", "#18181b");
        ctx.fillStyle = surfBg;
        ctx.strokeStyle = borderCol;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.roundRect(bx, by, twp, th, 6);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = txtCol;
        ctx.textBaseline = "middle";
        ctx.fillText(label, bx + pad, by + 13);
      }
    }
  }

  // --- UI initialization (script is inline → DOM elements above exist) ---
  // View switching
  let gBtn = document.getElementById("view-graph-btn");
  let tBtn = document.getElementById("view-tree-btn");
  if (gBtn) {
    gBtn.addEventListener("click", function() {
      document.getElementById("vault-graph").classList.remove("hidden");
      document.getElementById("vault-tree").classList.add("hidden");
      this.className = "rounded-md px-4 py-2 text-sm transition-all bg-white dark:d-raised shadow-sm font-semibold text-(--color-accent)";
      let other = document.getElementById("view-tree-btn");
      if (other) other.className = "rounded-md px-4 py-2 text-sm transition-all d-text-sec";
      initGraph();
    });
  }
  if (tBtn) {
    tBtn.addEventListener("click", function() {
      document.getElementById("vault-graph").classList.add("hidden");
      document.getElementById("vault-tree").classList.remove("hidden");
      this.className = "rounded-md px-4 py-2 text-sm transition-all bg-white dark:d-raised shadow-sm font-semibold text-(--color-accent)";
      let other = document.getElementById("view-graph-btn");
      if (other) other.className = "rounded-md px-4 py-2 text-sm transition-all d-text-sec";
    });
  }

  // Accordion
  document.querySelectorAll(".vault-section-header").forEach(function(btn) {
    btn.addEventListener("click", function() {
      this.closest(".vault-section").classList.toggle("collapsed");
    });
  });

  var activeTag = 'all';
  var searchQuery = '';

  function applyFilters() {
    var entries = document.querySelectorAll('.vault-entry');
    entries.forEach(function(el) {
      var matchTag = activeTag === 'all' || (el.dataset.tags || '').includes(activeTag);
      var matchSearch = searchQuery === '' || el.textContent.toLowerCase().includes(searchQuery);
      el.style.display = (matchTag && matchSearch) ? '' : 'none';
    });
    document.querySelectorAll('.vault-section').forEach(function(el) {
      var visible = false;
      el.querySelectorAll('.vault-entry').forEach(function(e) { if (e.style.display !== 'none') visible = true; });
      el.style.display = visible ? '' : 'none';
    });
  }

  // Search
  var searchInput = document.getElementById('vault-search');
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      searchQuery = this.value.toLowerCase();
      applyFilters();
    });
  }

  // Tag filter
  document.querySelectorAll('.tag-filter').forEach(function(btn) {
    btn.addEventListener('click', function() {
      activeTag = this.dataset.tag;
      document.querySelectorAll('.tag-filter').forEach(function(b) {
        b.className = b.dataset.tag === activeTag
          ? 'tag-filter active rounded-full px-3 py-1 text-xs font-medium bg-(--color-accent) text-white'
          : 'tag-filter rounded-full px-3 py-1 text-xs font-medium bg-stone-100 dark:d-surface d-text-sec hover:bg-stone-200 dark:d-hover transition-colors';
      });
      applyFilters();
    });
  });

  // Mobile filter toggle
  var toggle = document.getElementById("filter-toggle");
  var body = document.getElementById("filter-body");
  if (toggle && body) {
    toggle.addEventListener("click", function() {
      body.classList.toggle("open");
      toggle.classList.toggle("open");
    });
  }

  // All toggle (Tutti) — toggle: se tutti attivi, deseleziona tutti; altrimenti seleziona tutti
  var allBtn = document.querySelector('.group-filter[data-group="all"]');
  if (allBtn) {
    allBtn.addEventListener("click", function() {
      var allActive = hiddenSections.size === 0 && hiddenGroups.size === 0;
      if (allActive) {
        // Tutti attivi → deseleziona tutto
        var sectionBtns = document.querySelectorAll(".section-filter");
        sectionBtns.forEach(function(btn) { btn.classList.remove("active"); });
        sectionBtns.forEach(function(btn) { hiddenSections.add(btn.dataset.section); });
        document.querySelectorAll(".group-filter:not([data-group='all'])").forEach(function(btn) {
          btn.classList.remove("active");
          hiddenGroups.add(btn.dataset.group);
        });
        this.classList.remove("active");
      } else {
        // Qualcuno deselezionato → seleziona tutto
        hiddenSections = new Set();
        hiddenGroups = new Set();
        document.querySelectorAll(".section-filter").forEach(function(btn) {
          btn.classList.add("active");
        });
        document.querySelectorAll(".group-filter").forEach(function(btn) {
          btn.classList.remove("active");
        });
        this.classList.add("active");
      }
      filterDirty = true;
      if (sim) zoomToFit();
    });
  }

  // Section filter
  document.querySelectorAll(".section-filter").forEach(function(btn) {
    btn.addEventListener("click", function() {
      var sec = this.dataset.section;
      var isActive = this.classList.contains("active");
      this.classList.toggle("active");
      if (isActive) {
        hiddenSections.add(sec);
      } else {
        hiddenSections.delete(sec);
      }
      filterDirty = true;
      var ab = document.querySelector('.group-filter[data-group="all"]');
      if (ab) {
        var totalSectionFilters = document.querySelectorAll(".section-filter").length;
        var activeFilters = document.querySelectorAll(".section-filter.active").length;
        ab.classList.toggle("active", activeFilters === totalSectionFilters);
      }
      if (sim) zoomToFit();
    });
  });

  // Group filter
  document.querySelectorAll(".group-filter:not([data-group='all'])").forEach(function(btn) {
    btn.addEventListener("click", function() {
      var group = this.dataset.group;
      var isActive = this.classList.contains("active");
      if (isActive) {
        hiddenGroups.delete(group);
      } else {
        hiddenGroups.add(group);
      }
      this.classList.toggle("active");
      filterDirty = true;
      if (sim) zoomToFit();
    });
  });

  // Init graph — requestAnimationFrame per mobile (layout già calcolato)
  // Il click handler su #view-graph-btn (sopra) chiama gia' initGraph(),
  // quindi se il container e' nascosto parte al primo click sull'apposito pulsante.
  if (document.getElementById("force-graph") && document.getElementById("force-graph").offsetParent !== null) {
    requestAnimationFrame(function() { initGraph(); });
  }

  // Full-page toggle
  var fsBtn = document.getElementById("ctrl-fullscreen");
  if (fsBtn) {
    fsBtn.addEventListener("click", function() {
      var graph = document.getElementById("vault-graph");
      if (!graph) return;
      var isFull = graph.classList.contains("fullscreen");
      if (isFull) {
        graph.classList.remove("fullscreen");
        this.title = "Vista completa";
      } else {
        graph.classList.add("fullscreen");
        this.title = "Chiudi vista completa";
      }
      // Re-render graph at new dimensions
      setTimeout(function() {
        if (sim) {
          var w = canvas.width, h = canvas.height;
          sim.force("center", d3.forceCenter(w / 2, h / 2).strength(0.3));
          zoomToFit();
          sim.alpha(0.2).restart();
        }
      }, 100);
    });
    // Escape key exits fullscreen
    document.addEventListener("keydown", function(e) {
      if (e.key === "Escape") {
        var graph = document.getElementById("vault-graph");
        if (graph && graph.classList.contains("fullscreen")) {
          graph.classList.remove("fullscreen");
          fsBtn.title = "Vista completa";
          if (sim) {
            setTimeout(function() {
              zoomToFit();
              sim.alpha(0.2).restart();
            }, 100);
          }
        }
      }
    });
  }
})();
</script>

<style is:global>
  .collapsed .vault-section-body { display: none; }
  .collapsed .vault-section-header span:last-child { transform: rotate(180deg); }
  .vault-section-header span:last-child { transition: transform 0.2s; }
  .vault-entry { text-decoration: none; color: inherit; }
  .vault-entry:hover { text-decoration: none; }
  .section-filter:not(.active) { opacity: 0.45; filter: saturate(0.3); }

  /* Mobile: filter collapse */
  @media (max-width: 640px) {
    #filter-body {
      display: none;
    }
    #filter-body.open {
      display: flex;
    }
    #filter-toggle.open span:last-child {
      transform: rotate(180deg);
    }
    .tension-badge {
      display: none;
    }
  }
