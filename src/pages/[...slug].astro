---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import SectionDiscussion from "../components/SectionDiscussion.astro";

export async function getStaticPaths() {
  const peeragogyEntries = await getCollection("peeragogy");
  const unpeeragogyEntries = await getCollection("unpeeragogy");
  const allSlugs = new Set([
    ...peeragogyEntries.map((e) => e.slug),
    ...unpeeragogyEntries.map((e) => e.slug),
  ]);
  return Array.from(allSlugs).map((slug) => {
    const pEntry = peeragogyEntries.find((e) => e.slug === slug);
    const uEntry = unpeeragogyEntries.find((e) => e.slug === slug);
    return {
      params: { slug },
      props: { peeragogyEntry: pEntry || null, unpeeragogyEntry: uEntry || null },
    };
  });
}

const { peeragogyEntry, unpeeragogyEntry } = Astro.props;
const title = peeragogyEntry?.data?.title || unpeeragogyEntry?.data?.title || "Untitled";

let PeeragogyContent = null;
if (peeragogyEntry) {
  const { Content } = await peeragogyEntry.render();
  PeeragogyContent = Content;
}

let UnpeeragogyContent = null;
if (unpeeragogyEntry) {
  const { Content } = await unpeeragogyEntry.render();
  UnpeeragogyContent = Content;
}

const allPeeragogy = await getCollection("peeragogy");
const sorted = allPeeragogy.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const currentIndex = sorted.findIndex((e) => e.slug === peeragogyEntry?.slug);
const prev = currentIndex > 0 ? sorted[currentIndex - 1] : null;
const next = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;
---

<BaseLayout title={title} description={peeragogyEntry?.data?.description || unpeeragogyEntry?.data?.description}>
  <!-- View Toggle (hidden for single-column Foreword) -->
  {peeragogyEntry?.slug !== 'foreword' ? (
  <div class="flex items-center justify-center gap-2 mb-6 p-2 bg-stone-100 d-surface rounded-lg mx-auto max-w-full overflow-x-auto">
    <button
      @click="view = 'dual'"
      :class="view === 'dual' ? 'bg-white d-raised shadow-sm font-semibold text-(--color-accent)' : 'd-text-sec hover:text-(--color-text)'"
      class="rounded-md px-3 sm:px-4 py-2 text-xs sm:text-sm transition-all whitespace-nowrap"
    >
      ⿻ Dual
    </button>
    <button
      @click="view = 'peeragogy'"
      :class="view === 'peeragogy' ? 'bg-white d-raised shadow-sm font-semibold text-(--color-accent)' : 'd-text-sec hover:text-(--color-text)'"
      class="rounded-md px-3 sm:px-4 py-2 text-xs sm:text-sm transition-all whitespace-nowrap"
    >
      📖 Theory
    </button>
    <button
      @click="view = 'unpeeragogy'"
      :class="view === 'unpeeragogy' ? 'bg-white d-raised shadow-sm font-semibold text-(--color-accent)' : 'd-text-sec hover:text-(--color-text)'"
      class="rounded-md px-3 sm:px-4 py-2 text-xs sm:text-sm transition-all whitespace-nowrap"
    >
      ⚡ Friction
    </button>
  </div>
  ) : null}

  <!-- Epistemic framing bar (on dual-capable pages) -->
  {peeragogyEntry?.slug !== 'foreword' ? (
    <div class="mb-6 flex flex-wrap items-center gap-2 text-[10px] sm:text-xs d-text-dim border-b border-stone-200 d-border pb-3">
      <span class="font-medium text-(--color-accent)">📖 Source</span>
      <span class="opacity-50">→</span>
      <span class="font-medium text-amber-600 dark:text-amber-400">⚡ Observation</span>
      <span class="mx-2 opacity-30">·</span>
      <span class="italic">Where the pattern works</span>
      <span class="opacity-50">/</span>
      <span class="italic">Where the pattern breaks</span>
      <span class="mx-2 opacity-30">·</span>
      <span class="text-[10px] opacity-60">Interpretation ≠ Conclusion</span>
    </div>
  ) : null}

  <!-- Foreword: single column, full width, no Unpeeragogy -->
  {peeragogyEntry?.slug === 'foreword' ? (
    <div class="max-w-3xl mx-auto" data-pagefind-body>
      <div class="scroll-sync peeragogy-col">
        {PeeragogyContent ? (
          <article>
            <header class="mb-6">
              <p class="text-sm font-medium text-(--color-accent)">{peeragogyEntry.data.section}</p>
              <h1 class="text-2xl font-bold tracking-tight mt-1">{peeragogyEntry.data.title}</h1>
              {peeragogyEntry.data.description && (
                <p class="mt-2 text-sm d-text-sec">{peeragogyEntry.data.description}</p>
              )}
              <div class="mt-2 flex items-center gap-3 text-xs d-text-dim">
                <span>⏱ {peeragogyEntry.data.readingTime} min</span>
              </div>
            </header>
            <div class="prose max-w-none prose-sm">
              <PeeragogyContent />
            </div>
          </article>
        ) : (
          <div class="flex items-center justify-center h-64 d-text-dim italic">
            <p>No Peeragogy content for this section.</p>
          </div>
        )}
      </div>
    </div>
  ) : (
    <div class="flex gap-8">
      <!-- Sidebar TOC -->
      <aside class="hidden lg:block w-64 shrink-0">
        <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto">
          <TableOfContents slug={peeragogyEntry?.slug || unpeeragogyEntry?.slug} section={peeragogyEntry?.data?.section || unpeeragogyEntry?.data?.section} />
        </div>
      </aside>

      <!-- Dual Column Layout -->
      <div
        class="min-w-0 flex-1"
        :class="view === 'dual' ? 'flex flex-col lg:grid lg:grid-cols-2 gap-6' : 'max-w-3xl mx-auto'"
        data-pagefind-body
      >
        <!-- LEFT COLUMN: Peeragogy -->
        <div
          x-show="view === 'dual' || view === 'peeragogy'"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          class="scroll-sync peeragogy-col"
          :class="view === 'dual' ? 'lg:border-r lg:border-stone-200 d-border lg:pr-4' : ''"
          @scroll.throttle="if (!syncing && scrollSync && view === 'dual' && window.innerWidth >= 1024) { syncing = true; var el = $el.closest('div').querySelector('.unpeeragogy-col'); if (el) el.scrollTop = $el.scrollTop; requestAnimationFrame(() => syncing = false) }"
        >
          {PeeragogyContent ? (
            <article>
              <header class="mb-6">
                <p class="text-sm font-medium text-(--color-accent)">{peeragogyEntry.data.section}</p>
                <h1 class="text-2xl font-bold tracking-tight mt-1">{peeragogyEntry.data.title}</h1>
                {peeragogyEntry.data.description && (
                  <p class="mt-2 text-sm d-text-sec">{peeragogyEntry.data.description}</p>
                )}
                <div class="mt-2 flex items-center gap-3 text-xs d-text-dim">
                  <span>⏱ {peeragogyEntry.data.readingTime} min</span>
                  {peeragogyEntry.data.tags?.length > 0 && (
                    <span class="flex gap-1">
                      {peeragogyEntry.data.tags.map((tag) => (
                        <span class="rounded-full bg-stone-100 d-surface px-2 py-0.5">{tag}</span>
                      ))}
                    </span>
                  )}
                </div>
              </header>
              <div class="prose max-w-none prose-sm">
                <PeeragogyContent />
              </div>
            </article>
          ) : (
            <div class="flex items-center justify-center h-64 d-text-dim italic">
              <p>No Peeragogy content for this section.</p>
            </div>
          )}
        </div>

        <!-- RIGHT COLUMN: Unpeeragogy -->
        <div
          x-show="view === 'dual' || view === 'unpeeragogy'"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          class="scroll-sync unpeeragogy-col"
          :class="view === 'dual' ? 'lg:pl-2' : ''"
          @scroll.throttle="if (!syncing && scrollSync && view === 'dual' && window.innerWidth >= 1024) { syncing = true; var el = $el.closest('div').querySelector('.peeragogy-col'); if (el) el.scrollTop = $el.scrollTop; requestAnimationFrame(() => syncing = false) }"
        >
          {UnpeeragogyContent ? (
            <article>
              <header class="mb-6">
                <p class="text-sm font-medium text-amber-600 dark:text-amber-400">⚡ Unpeeragogy · Friction · Observation</p>
                <h1 class="text-2xl font-bold tracking-tight mt-1">{unpeeragogyEntry.data.title}</h1>
                <div class="mt-2 flex items-center gap-3 text-xs d-text-dim">
                  <span>⏱ {unpeeragogyEntry.data.readingTime} min</span>
                  {unpeeragogyEntry.data.tags?.length > 0 && (
                    <span class="flex gap-1">
                      {unpeeragogyEntry.data.tags.map((tag) => (
                        <span class="rounded-full bg-red-50 text-red-600 d-red-bg d-red-txt px-2 py-0.5">{tag}</span>
                      ))}
                    </span>
                  )}
                </div>
              </header>
              <div class="prose max-w-none prose-sm prose-amber">
                <UnpeeragogyContent />
              </div>
              <SectionDiscussion slug={unpeeragogyEntry.slug} title={unpeeragogyEntry.data.title} />
            </article>
          ) : (
            <div class="flex items-center justify-center h-64 d-text-dim italic">
              <p>No Unpeeragogy observations recorded yet for this section. The Perturbator is watching — for now.</p>
            </div>
          )}
        </div>
      </div>
    </div>
  )}

  <!-- Prev/Next navigation -->
  <nav class="mt-8 flex items-center justify-between border-t border-stone-200 d-border pt-6 gap-4">
    <div class="min-w-0 flex-1">
      {prev && (
        <a href={`/${prev.slug}/`} class="group flex flex-col">
          <span class="text-xs sm:text-sm d-text-dim">← Previous</span>
          <span class="text-sm sm:text-base font-medium truncate group-hover:text-(--color-accent) transition-colors">{prev.data.title}</span>
        </a>
      )}
    </div>
    <div class="min-w-0 flex-1 text-right">
      {next && (
        <a href={`/${next.slug}/`} class="group flex flex-col">
          <span class="text-xs sm:text-sm d-text-dim">Next →</span>
          <span class="text-sm sm:text-base font-medium truncate group-hover:text-(--color-accent) transition-colors">{next.data.title}</span>
        </a>
      )}
    </div>
  </nav>

  <!-- Epistemic CTA -->
  <div class="mt-12 text-center border-t border-stone-200 d-border pt-8">
    <p class="text-sm d-text-dim mb-6 max-w-lg mx-auto">
      Every pattern raises more questions than it answers.<br>
      <span class="italic">Read the theory. Then look at what happened.</span>
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/vault/" class="rounded-lg bg-(--color-accent) px-5 py-2.5 text-sm font-semibold text-white hover:bg-(--color-accent-light) transition-colors">
        🗂️ Browse all patterns
      </a>
      <a href="/why/" class="rounded-lg border border-stone-300 d-border px-5 py-2.5 text-sm font-semibold hover:bg-stone-100 d-hover transition-colors">
        Why this project? →
      </a>
      <a href="/" class="rounded-lg border border-stone-300 d-border px-5 py-2.5 text-sm font-semibold hover:bg-stone-100 d-hover transition-colors">
        ← Back home
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .scroll-sync { scroll-behavior: smooth; }
  .prose-amber :deep(blockquote) { border-left-color: #d97706; }
  .prose-amber :deep(strong) { color: var(--color-text); }
</style>