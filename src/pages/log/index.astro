---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const logEntries = await getCollection("log");
const sorted = logEntries.sort((a, b) => b.data.month.localeCompare(a.data.month));
---

<BaseLayout title="Log mensile" description="Registro delle revisioni mensili di Unpeeragogy — discussioni attive, entry modificate, evoluzione del grafo.">
  <section class="py-12" data-pagefind-body>
    <h1 class="text-3xl font-extrabold tracking-tight mb-2">📋 Log mensile</h1>
    <p class="d-text-sec mb-8">
      Ogni mese il progetto analizza le discussioni attive e le modifiche alle entry,
      e registra qui cosa è cambiato. <em>Trasparenza radicale, niente changelog cosmetico.</em>
    </p>

    <div class="space-y-6">
      {sorted.length === 0 && (
        <p class="d-text-dim italic">Nessun log ancora registrato.</p>
      )}

      {sorted.map((entry) => (
        <a
          href={`/log/${entry.slug}/`}
          class="block p-6 border border-stone-200 d-border rounded-lg hover:bg-stone-50 d-hover transition-colors"
        >
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <h2 class="text-lg font-bold text-(--color-accent)">{entry.data.title}</h2>
              <p class="mt-1 text-sm d-text-sec">{entry.data.description}</p>
            </div>
            <span class="shrink-0 rounded-full bg-stone-100 d-surface px-3 py-1 text-xs font-medium">
              {entry.data.month}
            </span>
          </div>

          <div class="mt-4 flex flex-wrap gap-3 text-xs d-text-dim">
            <span>🕸️ {entry.data.metrics.nodeCount} nodi</span>
            <span>🔗 {entry.data.metrics.linkCount} link</span>
            <span>⚡ tensione Ø {entry.data.metrics.avgTension}</span>
            <span>📝 {entry.data.metrics.totalWords} parole</span>
            <span>💬 {entry.data.metrics.discussionsActive} discussioni</span>
          </div>

          {entry.data.changes.length > 0 && (
            <ul class="mt-3 space-y-1">
              {entry.data.changes.slice(0, 3).map((c) => (
                <li class="text-xs d-text-dim flex items-start gap-2">
                  <span class="shrink-0 mt-0.5">
                    {c.type === "discussion" && "💬"}
                    {c.type === "entry" && "✏️"}
                    {c.type === "graph" && "🕸️"}
                    {c.type === "decision" && "⚡"}
                  </span>
                  <span>{c.description}</span>
                </li>
              ))}
              {entry.data.changes.length > 3 && (
                <li class="text-xs d-text-dim">… e altre {entry.data.changes.length - 3} modifiche</li>
              )}
            </ul>
          )}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>