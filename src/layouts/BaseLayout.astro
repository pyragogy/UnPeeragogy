---
import "../styles/globals.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { Icon } from "astro-icon/components";

export interface Props {
  title: string;
  description?: string;
  viewDefault?: "dual" | "peeragogy" | "unpeeragogy";
}

const { title, description, viewDefault = "dual" } = Astro.props;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/why/", label: "Why" },
  { href: "/vault/", label: "Vault" },
  { href: "/mcp/", label: "MCP" },
  { href: "/log/", label: "Log" },
];
---

<!doctype html>
<html lang="it" class="">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || "Unpeeragogy — decostruzione radicale della teoria peer-to-peer"} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://unpeeragogy.pyragogy.org${Astro.url.pathname}`} />
    <meta property="og:image" content="https://unpeeragogy.pyragogy.org/images/UnPeeragogy-logo-test.webp" />
    <meta property="og:locale" content="it_IT" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description || "Decostruzione della teoria peer-to-peer"} />
    <meta name="twitter:image" content="https://unpeeragogy.pyragogy.org/images/UnPeeragogy-logo-test.webp" />
    <!-- GEO / Location (per motori di ricerca geolocalizzati) -->
    <meta name="geo.region" content="IT" />
    <meta name="geo.placename" content="Italia" />
    <!-- RSS Feed -->
    <link rel="alternate" type="application/atom+xml" title="Unpeeragogy Feed" href="https://unpeeragogy.pyragogy.org/feed.xml" />
    <!-- canonical -->
    <link rel="canonical" href={`https://unpeeragogy.pyragogy.org${Astro.url.pathname}`} />
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="alternate icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Schema.org base -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://unpeeragogy.pyragogy.org/#website",
        "url": "https://unpeeragogy.pyragogy.org",
        "name": "Unpeeragogy",
        "description": "Decostruzione radicale della teoria peer-to-peer, confrontata con la realtà operativa quotidiana.",
        "inLanguage": "it",
        "isAccessibleForFree": true,
        "license": "https://creativecommons.org/publicdomain/zero/1.0/",
        "about": {
          "@type": "Thing",
          "name": "Peeragogy",
          "description": "Teoria e pratica dell'apprendimento peer-to-peer"
        }
      }
    </script>
    <script is:inline>
      const theme = localStorage.getItem("theme");
      if (theme === "dark" || (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.documentElement.classList.add("dark");
      }
    </script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </head>
  <body
    class="min-h-screen bg-(--color-bg) text-(--color-text) antialiased"
    x-data="{ view: 'dual', scrollSync: true }"
    x-init="$watch('view', val => { if (val === 'dual') scrollSync = true })"
  >
    <header class="sticky top-0 z-40 border-b border-stone-200 d-border bg-(--color-bg)/95 backdrop-blur supports-[backdrop-filter]:bg-(--color-bg)/80">
      <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
        <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight hover:text-(--color-accent) transition-colors whitespace-nowrap">
          <span class="text-xl">⧩</span> Unpeeragogy
        </a>
        <div class="flex items-center gap-1 text-sm">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="rounded-md px-3 py-1.5 transition-colors hover:bg-stone-200 d-hover hover:text-(--color-accent)"
              >
                {link.label}
              </a>
            ))
          }
        </div>
        <div class="flex items-center">
          <a
            href="https://notebook.google.com/notebook/7d483314-7344-4718-9a6e-5f43524c8c0f"
            target="_blank"
            class="rounded-md p-2 transition-colors hover:bg-stone-200 d-hover"
            aria-label="Notebook"
          >
            <Icon name="mingcute:book-2-line" size={20} aria-hidden="true" />
          </a>
          <a
            href="https://github.com/pyragogy/UnPeeragogy"
            target="_blank"
            class="rounded-md p-2 transition-colors hover:bg-stone-200 d-hover"
            aria-label="GitHub"
          >
            <Icon name="mingcute:github-line" size={20} aria-hidden="true" />
          </a>
          <button id="search-toggle" class="cursor-pointer rounded-md p-2 transition-colors hover:bg-stone-200 d-hover" aria-label="Search">
            <Icon name="mingcute:search-line" size={20} aria-hidden="true" />
          </button>
          <ThemeToggle />
        </div>
      </nav>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8">
      <div id="search" class="hidden mb-8"></div>
      <slot />
    </main>

    <footer>
      <div class="legal-bar">
        <p class="legal-line">
          © {new Date().getFullYear()} Fabrizio Terzi — P.IVA IT04923300166
        </p>
        <nav class="legal-links">
          <a href="/privacy/">Privacy Policy</a>
          <span class="sep">·</span>
          <a href="/cookies/">Cookie Policy</a>
          <span class="sep">·</span>
          <a href="/terms/">Termini di Servizio</a>
          <span class="sep">·</span>
          <a href="javascript:void(0)" id="manage-cookie" onclick="window.__cc?.showPreferences?.()">Gestisci Cookie</a>
          <span class="sep">·</span>
          <a href="https://www.linkedin.com/in/bergamohub001/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <span class="sep">·</span>
          <a href="mailto:info@pyragogy.org">info@pyragogy.org</a>
        </nav>
        <p class="legal-note">
          Contenuti in <a href="https://creativecommons.org/publicdomain/zero/1.0/" target="_blank" rel="noopener noreferrer" class="underline hover:text-(--color-accent)">CC Zero</a> — Public Domain Dedication.
        </p>
      </div>
    </footer>

    <CookieConsent />

    <script>
      document.getElementById('manage-cookie')?.addEventListener('click', (e) => {
        e.preventDefault();
        if (window.__cc?.showPreferences) {
          window.__cc.showPreferences();
        }
      });
    </script>
  </body>
</html>

<style>
  .legal-bar {
    text-align: center;
    padding: 1.5rem 0 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border-color, #e4e4e7);
  }
  :root.dark .legal-bar {
    border-top-color: var(--border-dark, #27272a);
  }
  .legal-line {
    margin: 0 0 0.5rem;
    font-weight: 600;
  }
  .legal-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .legal-links a {
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  .legal-links a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }
  .legal-links .sep {
    color: var(--text-secondary);
    opacity: 0.5;
  }
  .legal-note {
    margin: 0.25rem 0 0;
    font-size: 0.75rem;
    opacity: 0.7;
  }
  .legal-note a {
    color: var(--color-accent);
  }
</style>

<script>
  document.getElementById("search-toggle")?.addEventListener("click", () => {
    if (window.PagefindUI) {
      document.getElementById("search")?.classList.toggle("hidden");
    } else {
      const script = document.createElement("script");
      script.src = "/pagefind/pagefind-ui.js";
      script.onload = () => {
        new window.PagefindUI({ element: "#search", showSubResults: true, resetStyles: false });
        document.getElementById("search")?.classList.remove("hidden");
      };
      document.body.appendChild(script);
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = "/pagefind/pagefind-ui.css";
      document.head.appendChild(link);
    }
  });
</script>