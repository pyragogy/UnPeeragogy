---
import "../styles/globals.css";
import ThemeToggle from "../components/ThemeToggle.astro";

export interface Props {
  title: string;
  description?: string;
  viewDefault?: "dual" | "peeragogy" | "unpeeragogy";
}

const { title, description, viewDefault = "dual" } = Astro.props;
---

<!doctype html>
<html lang="it" class="">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || "Unpeeragogy — decostruzione radicale della teoria peer-to-peer"} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://unpeeragogy.pyragogy.org${Astro.url.pathname}`} />
    <meta property="og:image" content="https://unpeeragogy.pyragogy.org/images/UnPeeragogy-logo-test.webp" />
    <meta property="og:locale" content="it_IT" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description || "Decostruzione della teoria peer-to-peer"} />
    <meta name="twitter:image" content="https://unpeeragogy.pyragogy.org/images/UnPeeragogy-logo-test.webp" />
    <!-- GEO / Location (per motori di ricerca geolocalizzati) -->
    <meta name="geo.region" content="IT" />
    <meta name="geo.placename" content="Italia" />
    <!-- RSS Feed -->
    <link rel="alternate" type="application/atom+xml" title="Unpeeragogy Feed" href="https://unpeeragogy.pyragogy.org/feed.xml" />
    <!-- canonical -->
    <link rel="canonical" href={`https://unpeeragogy.pyragogy.org${Astro.url.pathname}`} />
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="alternate icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Schema.org base -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://unpeeragogy.pyragogy.org/#website",
        "url": "https://unpeeragogy.pyragogy.org",
        "name": "Unpeeragogy",
        "description": "Decostruzione radicale della teoria peer-to-peer, confrontata con la realtà operativa quotidiana.",
        "inLanguage": "it",
        "isAccessibleForFree": true,
        "license": "https://creativecommons.org/publicdomain/zero/1.0/",
        "about": {
          "@type": "Thing",
          "name": "Peeragogy",
          "description": "Teoria e pratica dell'apprendimento peer-to-peer"
        }
      }
    </script>
    <script is:inline>
      const theme = localStorage.getItem("theme");
      if (theme === "dark" || (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.documentElement.classList.add("dark");
      }
    </script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </head>
  <body
    class="min-h-screen bg-(--color-bg) text-(--color-text) antialiased"
    x-data="{ view: 'dual', scrollSync: true }"
    x-init="$watch('view', val => { if (val === 'dual') scrollSync = true })"
  >
    <header class="sticky top-0 z-40 border-b border-stone-200 d-border bg-(--color-bg)/95 backdrop-blur supports-[backdrop-filter]:bg-(--color-bg)/80">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href="/" class="text-lg font-bold tracking-tight hover:text-(--color-accent) transition-colors">
          ⧩ Unpeeragogy
        </a>
        <div class="flex items-center gap-4">
          <a href="/" class="text-sm hover:text-(--color-accent) transition-colors">Home</a>
          <a href="/vault/" class="text-sm hover:text-(--color-accent) transition-colors">🗂️ Vault</a>
          <a href="/why/" class="text-sm font-medium text-(--color-accent) hover:underline transition-colors">Why</a>
          <a href="/mcp/" class="text-sm hover:text-(--color-accent) transition-colors">⚡ MCP</a>
          <a href="https://notebook.google.com/notebook/7d483314-7344-4718-9a6e-5f43524c8c0f" target="_blank" class="text-sm hover:text-(--color-accent) transition-colors">📓 Notebook</a>
          <a href="/log/" class="text-sm hover:text-(--color-accent) transition-colors">📋 Log</a>
          <button id="search-toggle" class="cursor-pointer rounded-md p-2 text-sm hover:bg-stone-200 d-hover transition-colors" aria-label="Search">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>
          <ThemeToggle />
          <a href="https://github.com/pyragogy/UnPeeragogy" target="_blank" class="rounded-md p-2 hover:bg-stone-200 d-hover transition-colors" aria-label="GitHub">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </a>
        </div>
      </nav>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8">
      <div id="search" class="hidden mb-8"></div>
      <slot />
    </main>

    <footer class="border-t border-stone-200 d-border py-6 text-center text-sm d-text-dim">
      <p>
        Unpeeragogy — Decostruzione radicale della teoria peer-to-peer (<a href="https://creativecommons.org/publicdomain/zero/1.0/" class="underline hover:text-(--color-accent)">CC Zero</a>)
      </p>
    </footer>
  </body>
</html>

<script>
  document.getElementById("search-toggle")?.addEventListener("click", () => {
    if (window.PagefindUI) {
      document.getElementById("search")?.classList.toggle("hidden");
    } else {
      const script = document.createElement("script");
      script.src = "/pagefind/pagefind-ui.js";
      script.onload = () => {
        new window.PagefindUI({ element: "#search", showSubResults: true, resetStyles: false });
        document.getElementById("search")?.classList.remove("hidden");
      };
      document.body.appendChild(script);
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = "/pagefind/pagefind-ui.css";
      document.head.appendChild(link);
    }
  });
</script>