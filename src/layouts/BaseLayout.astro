---
import "../styles/globals.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import CookieConsent from "../components/CookieConsent.astro";
import ObfuscatedEmail from "../components/ObfuscatedEmail.astro";
import { Icon } from "astro-icon/components";

export interface Props {
  title: string;
  description?: string;
  viewDefault?: "dual" | "peeragogy" | "unpeeragogy";
}

const { title, description, viewDefault = "dual" } = Astro.props;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/why/", label: "Why" },
  { href: "/protocol/", label: "Protocol" },
  { href: "/perturbator/", label: "Perturbator" },
  { href: "/vault/", label: "Vault" },
  { href: "/mcp/", label: "MCP" },
  { href: "/log/", label: "Log" },
];
---

<!doctype html>
<html lang="en" class="">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || "Unpeeragogy — decostruzione radicale della teoria peer-to-peer"} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://unpeeragogy.pyragogy.org${Astro.url.pathname}`} />
    <meta property="og:image" content="https://unpeeragogy.pyragogy.org/images/UnPeeragogy-logo-test.webp" />
    <meta property="og:locale" content="it_IT" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description || "Decostruzione della teoria peer-to-peer"} />
    <meta name="twitter:image" content="https://unpeeragogy.pyragogy.org/images/UnPeeragogy-logo-test.webp" />
    <!-- GEO / Location (per motori di ricerca geolocalizzati) -->
    <meta name="geo.region" content="IT" />
    <meta name="geo.placename" content="Italia" />
    <!-- RSS Feed -->
    <link rel="alternate" type="application/atom+xml" title="Unpeeragogy Feed" href="https://unpeeragogy.pyragogy.org/feed.xml" />
    <!-- canonical -->
    <link rel="canonical" href={`https://unpeeragogy.pyragogy.org${Astro.url.pathname}`} />
    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Content-Security-Policy -->
    <meta http-equiv="Content-Security-Policy" content="
      default-src 'self';
      script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://plausible.pyragogy.org https://giscus.app https://*.github.com;
      style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com;
      img-src 'self' data: https://plausible.pyragogy.org https://*.githubusercontent.com https://*.github.com;
      connect-src 'self' https://api.github.com https://plausible.pyragogy.org https://cdn.jsdelivr.net wss://*.giscus.app;
      frame-src https://giscus.app;
      font-src 'self' data:;
      base-uri 'self';
      form-action 'self';
      manifest-src 'self';
    " />
    <!-- Schema.org base -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://unpeeragogy.pyragogy.org/#website",
        "url": "https://unpeeragogy.pyragogy.org",
        "name": "Unpeeragogy",
        "description": "Peeragogy, vista da vicino. Teoria, esperienza e attrito a confronto.",
        "inLanguage": "it",
        "isAccessibleForFree": true,
        "license": "https://creativecommons.org/publicdomain/zero/1.0/",
        "about": {
          "@type": "Thing",
          "name": "Peeragogy",
          "description": "Teoria e pratica dell'apprendimento peer-to-peer"
        }
      }
    </script>
    <script is:inline>
      // Default: dark mode sempre, a meno che utente abbia scelto light esplicitamente
      var t = localStorage.getItem("theme");
      if (t === "dark" || !t) { document.documentElement.classList.add("dark"); }
    </script>
    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.pyragogy.org/js/pa-HnqVZ-vv_1hJCCbmKAafG.js" data-domain="unpeeragogy.pyragogy.org"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)};plausible.init=plausible.init||function(i){plausible.o=i||{}};plausible.init()
    </script>

    <!-- Organization Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "@id": "https://unpeeragogy.pyragogy.org/#organization",
        "name": "Unpeeragogy",
        "url": "https://unpeeragogy.pyragogy.org",
        "description": "Peeragogy, vista da vicino. Teoria, esperienza e attrito a confronto.",
        "founder": {
          "@type": "Person",
          "name": "Fabrizio Terzi"
        },
        "foundingDate": "2025"
      }
    </script>

    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js" integrity="sha512-S0FmGVNvhIGBTFW8xl2Sb9VjaTqStfWO1KHQjaxvTESAOe0RlL7jITJQVmA5V1bu88Y9VgDoW7jqsQCYVRLx1Q==" crossorigin="anonymous"></script>
  </head>
  <body
    class="min-h-screen bg-(--color-bg) text-(--color-text) antialiased"
    x-data="{ view: 'dual', scrollSync: true, syncing: false }"
    x-init="$watch('view', val => { if (val === 'dual') scrollSync = true })"
  >
    <header class="sticky top-0 z-40 border-b border-stone-200 d-border bg-(--color-bg)/95 backdrop-blur supports-[backdrop-filter]:bg-(--color-bg)/80">
      <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
        <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight hover:text-(--color-accent) transition-colors whitespace-nowrap">
          <span class="text-xl">⧩</span> Unpeeragogy
        </a>

        <!-- Desktop nav links -->
        <div class="hidden sm:flex items-center gap-1 text-base leading-snug">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="rounded-md px-3 py-1.5 transition-colors hover:bg-stone-200 d-hover hover:text-(--color-accent)"
              >
                {link.label}
              </a>
            ))
          }
        </div>

        <div class="flex items-center">
          <!-- Mobile hamburger -->
          <button id="nav-toggle" class="sm:hidden cursor-pointer rounded-md p-2 transition-colors hover:bg-stone-200 d-hover" aria-label="Menu" aria-expanded="false">
            <Icon name="mingcute:menu-line" id="hamburger-open" size={22} aria-hidden="true" />
            <Icon name="mingcute:close-line" id="hamburger-close" size={22} aria-hidden="true" class="hidden" />
          </button>
          <a
            href="https://notebook.google.com/notebook/7d483314-7344-4718-9a6e-5f43524c8c0f"
            target="_blank"
            class="hidden sm:inline-block rounded-md px-2.5 py-1.5 text-xs transition-colors hover:bg-stone-200 d-hover hover:text-(--color-accent)"
            aria-label="Notebook"
          >
            Notebook
          </a>
          <a
            href="https://github.com/pyragogy/UnPeeragogy"
            target="_blank"
            class="hidden sm:block rounded-md p-2 transition-colors hover:bg-stone-200 d-hover"
            aria-label="GitHub"
          >
            <Icon name="mingcute:github-line" size={20} aria-hidden="true" />
          </a>
          <button id="search-toggle" class="cursor-pointer rounded-md p-2 transition-colors hover:bg-stone-200 d-hover" aria-label="Search">
            <Icon name="mingcute:search-line" size={20} aria-hidden="true" />
          </button>
          <ThemeToggle />
        </div>
      </nav>

      <!-- Mobile nav drawer -->
      <div id="mobile-nav" class="sm:hidden hidden border-t border-stone-200 d-border bg-(--color-bg)/95 overflow-y-auto max-h-[80vh]">
        <div class="flex flex-col gap-1 px-4 py-3 text-base leading-snug">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="rounded-md px-3 py-2 transition-colors hover:bg-stone-200 d-hover hover:text-(--color-accent)"
              >
                {link.label}
              </a>
            ))
          }
          <div class="flex items-center gap-2 pt-2 mt-2 border-t border-stone-200 d-border">
            <a
              href="https://notebook.google.com/notebook/7d483314-7344-4718-9a6e-5f43524c8c0f"
              target="_blank"
              class="rounded-md px-2.5 py-1.5 text-xs transition-colors hover:bg-stone-200 d-hover hover:text-(--color-accent)"
              aria-label="Notebook"
            >
              Notebook
            </a>
            <a
              href="https://github.com/pyragogy/UnPeeragogy"
              target="_blank"
              class="rounded-md p-2 transition-colors hover:bg-stone-200 d-hover"
              aria-label="GitHub"
            >
              <Icon name="mingcute:github-line" size={20} aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-3 sm:px-4 py-6 sm:py-8">
      <div id="search" class="hidden mb-8"></div>
      <slot />
    </main>

    <footer>
      <div class="legal-bar">
        <p class="legal-line">
          © {new Date().getFullYear()} Fabrizio Terzi — <a href="https://orcid.org/0009-0004-7191-0455" target="_blank" rel="noopener noreferrer">ORCID 0009-0004-7191-0455</a>
        </p>
        <nav class="legal-links">
          <a href="/privacy/">Privacy Policy</a>
          <span class="sep">·</span>
          <a href="/cookies/">Cookie Policy</a>
          <span class="sep">·</span>
          <a href="/terms/">Terms of Service</a>
          <span class="sep">·</span>
          <a href="#" id="manage-cookie" onclick="window.__cc?.showPreferences?.()">Manage Cookies</a>
          <span class="sep">·</span>
          <a href="https://www.linkedin.com/in/bergamohub001/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <span class="sep">·</span>
          <ObfuscatedEmail />
        </nav>
        <p class="legal-note">
          Content in <a href="https://creativecommons.org/publicdomain/zero/1.0/" target="_blank" rel="noopener noreferrer" class="underline hover:text-(--color-accent)">CC Zero</a> — Public Domain Dedication.
        </p>
      </div>
    </footer>

    <CookieConsent />

    <script>
      // Hamburger toggle with icon swap + focus trap
      document.getElementById('nav-toggle')?.addEventListener('click', function() {
        var drawer = document.getElementById('mobile-nav');
        var openIcon = document.getElementById('hamburger-open');
        var closeIcon = document.getElementById('hamburger-close');
        if (drawer) {
          var isOpen = !drawer.classList.contains('hidden');
          drawer.classList.toggle('hidden');
          if (openIcon) openIcon.classList.toggle('hidden', isOpen);
          if (closeIcon) closeIcon.classList.toggle('hidden', !isOpen);
          this.setAttribute('aria-expanded', !isOpen);
          // Focus trap: when opening, focus first link in drawer
          if (!isOpen) {
            var firstLink = drawer.querySelector('a');
            if (firstLink) setTimeout(function() { firstLink.focus(); }, 100);
          }
        }
      });

      // Close drawer on Escape
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          var drawer = document.getElementById('mobile-nav');
          if (drawer && !drawer.classList.contains('hidden')) {
            drawer.classList.add('hidden');
            var openIcon = document.getElementById('hamburger-open');
            var closeIcon = document.getElementById('hamburger-close');
            if (openIcon) openIcon.classList.remove('hidden');
            if (closeIcon) closeIcon.classList.add('hidden');
            var toggle = document.getElementById('nav-toggle');
            if (toggle) { toggle.setAttribute('aria-expanded', 'false'); toggle.focus(); }
          }
        }
      });

      document.getElementById('manage-cookie')?.addEventListener('click', (e) => {
        e.preventDefault();
        if (window.__cc?.showPreferences) {
          window.__cc.showPreferences();
        }
      });

      // Close mobile nav and reset icon on link click
      document.querySelectorAll('#mobile-nav a').forEach(function(link) {
        link.addEventListener('click', function() {
          document.getElementById('mobile-nav')?.classList.add('hidden');
          document.getElementById('hamburger-open')?.classList.remove('hidden');
          document.getElementById('hamburger-close')?.classList.add('hidden');
        });
      });
    </script>
  </body>
</html>

<style>
  .legal-bar {
    text-align: center;
    padding: 1.5rem 0 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border-color, #e4e4e7);
  }
  :root.dark .legal-bar {
    border-top-color: var(--border-dark, #27272a);
  }
  .legal-line {
    margin: 0 0 0.5rem;
    font-weight: 600;
  }
  .legal-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .legal-links a {
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  .legal-links a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }
  .legal-links .sep {
    color: var(--text-secondary);
    opacity: 0.5;
  }
  .legal-note {
    margin: 0.25rem 0 0;
    font-size: 0.75rem;
    opacity: 0.7;
  }
  .legal-note a {
    color: var(--color-accent);
  }

  /* Mobile: footer link wrapping */
  @media (max-width: 640px) {
    .legal-links {
      gap: 0.3rem;
      font-size: 0.75rem;
    }
    .legal-links .sep {
      margin: 0 0.1rem;
    }
    .legal-bar {
      padding: 1rem 0.75rem 0.5rem;
    }
    .legal-line {
      font-size: 0.75rem;
    }
  }
</style>

<script>
  document.getElementById("search-toggle")?.addEventListener("click", () => {
    if (window.PagefindUI) {
      document.getElementById("search")?.classList.toggle("hidden");
    } else {
      const script = document.createElement("script");
      script.src = "/pagefind/pagefind-ui.js";
      script.onload = () => {
        new window.PagefindUI({ element: "#search", showSubResults: true, resetStyles: false });
        document.getElementById("search")?.classList.remove("hidden");
      };
      document.body.appendChild(script);
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = "/pagefind/pagefind-ui.css";
      document.head.appendChild(link);
    }
  });

  // Decode obfuscated email addresses
  document.querySelectorAll('.obfuscated-email').forEach(function(el) {
    var user = el.dataset.user;
    var domain = el.dataset.domain;
    var tld = el.dataset.tld;
    var as = el.dataset.as || 'link';
    var email = user + '@' + domain + '.' + tld;
    if (as === 'link') {
      el.innerHTML = '<a href="mailto:' + email + '">' + email + '</a>';
    } else if (as === 'code') {
      el.innerHTML = '<code>' + email + '</code>';
    } else {
      el.textContent = email;
    }
  });
</script>